{% assign collection_size = settings.collection_count | default: "12" %}

{% paginate products by collection_size %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Montserrat:wght@300;400;500;600;700&family=Roboto:wght@400;500;700&display=swap');
  .vl-collection,.vl-collection *{box-sizing:border-box}.vl-collection{width:min(100% - 40px,1240px);margin:0 auto;padding:80px 0;background:#fff;color:#0a0a0a;font-family:'Roboto',Arial,sans-serif}.vl-collection h1{margin:0 0 18px;font-family:'Playfair Display',serif;font-size:clamp(40px,6vw,68px);line-height:1;letter-spacing:-1px;text-transform:uppercase}.vl-collection .breadcrumb-wrapper{margin-bottom:25px}.vl-collection .breadcrumb{display:flex;flex-wrap:wrap;gap:8px;padding:0;margin:0;list-style:none}.vl-collection .breadcrumb-item{color:#777;font:13px 'Montserrat',sans-serif}.vl-collection .breadcrumb-item a{color:#000;text-decoration:none}.vl-collection .collection-sort.sort_main{margin-bottom:25px}.vl-collection .collection-order.is-sort .form-control{min-height:44px;min-width:200px;padding:0 15px;border:1px solid #000;border-radius:3px;background:#fff;color:#000;font:13px 'Montserrat',sans-serif}.vl-collection .product-preview{height:100%;padding:20px;border:1px solid #000!important;border-radius:14px!important;background:#fff!important;box-shadow:none!important;overflow:hidden}.vl-collection .product-preview__title{text-align:center}.vl-collection .product-preview__title a{color:#000!important;font:600 14px 'Montserrat',sans-serif!important;text-decoration:none!important}.vl-collection .product-preview__price{margin:12px 0;text-align:center}.vl-collection .product-preview__price-cur{color:#000;font:700 20px 'Montserrat',sans-serif}.vl-collection .product-preview__price-old{color:#777;text-decoration:line-through}.vl-collection .product-preview__area-bottom{display:flex;justify-content:flex-end;align-items:center;gap:12px}.vl-collection .product-preview__controls-left .button,.vl-collection .add-cart-counter__btn,.vl-collection .product-preview__controls .button{border:0!important;background:transparent!important;color:#000!important;font-family:'Montserrat',sans-serif!important}.vl-collection .pagination{display:flex;justify-content:center;gap:25px;margin:45px 0 0;padding:0;list-style:none}.vl-collection .pagination a,.vl-collection .pagination__item a,.vl-collection .pagination .page-link{color:#000;background:transparent;border:0;text-decoration:none;font:500 13px 'Montserrat',sans-serif}.vl-collection .pagination .active a,.vl-collection .pagination__item.active a{font-weight:700;border-bottom:1px solid #000}.vl-collection .filter__content{padding:25px;border:1px solid #000!important;border-radius:14px!important;background:#fff!important;box-shadow:none!important}.vl-collection .filter__head{border-bottom:1px solid #000}.vl-collection .filter__controls .button,.vl-collection .filter__reset-btn{min-height:44px;border:1px solid #000!important;border-radius:3px!important;background:#fff!important;color:#000!important;font:600 12px 'Montserrat',sans-serif!important;letter-spacing:1px;text-transform:uppercase}.vl-collection .filter__controls .button:hover,.vl-collection .filter__reset-btn:hover{background:#000!important;color:#fff!important}.vl-back-link{display:block;margin-top:45px;text-align:center;color:#000;text-decoration:none;font:500 13px 'Montserrat',sans-serif;letter-spacing:1.5px;text-transform:uppercase}@media(max-width:768px){.vl-collection{width:min(100% - 30px,1240px);padding:55px 0}}
</style>
<section class="vl-collection">
  {% for widgetDrop in widget_lists.collection-list.widgets %}
    {% widget widgetDrop %}
  {% endfor %}
  <a href="/" class="vl-back-link">← Вернуться на главную</a>
</section>
{% endpaginate %}
<!-- СТРАНИЦА СТАТЬИ -->
<div class="vl-article-page">
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "{{ article.title | escape }}",
      "description": "{{ article.excerpt_or_content | strip_html | strip_newlines | escape | truncate: 200 }}",
      "datePublished": "{{ article.published_at | date: '%Y-%m-%d' }}",
      "dateModified": "{{ article.published_at | date: '%Y-%m-%d' }}",
      "author": { "@type": "Person", "name": "{{ article.author | default: 'Veles Legs' | escape }}" },
      "publisher": {
        "@type": "Organization",
        "name": "Veles Legs",
        "logo": { "@type": "ImageObject", "url": "https://veles-legs.ru/logo.png" }
      },
      "mainEntityOfPage": { "@type": "WebPage", "@id": "https://veles-legs.ru{{ article.url }}" },
      "image": "{{ img_url | default: '' }}"
    }
  </script>

  <h1 class="vl-article-title">{{ article.title }}</h1>

  <div class="vl-article-meta">
    {% if article.author %}<span>{{ article.author }}</span>{% endif %}
    <span>{{ article.published_at | date: "%d.%m.%Y" }}</span>
  </div>

  {% assign img_url = '' %}
  {% if article.image and article.image.url != blank %}
    {% assign raw = article.image.url %}
    {% if raw contains 'http' %}{% assign img_url = raw %}{% else %}{% assign img_url = raw | prepend: 'https:' %}{% endif %}
  {% elsif article.image and article.image.src != blank %}
    {% assign raw = article.image.src %}
    {% if raw contains 'http' %}{% assign img_url = raw %}{% else %}{% assign img_url = raw | prepend: 'https:' %}{% endif %}
  {% endif %}

  {% if img_url != blank %}
    <figure class="vl-article-cover">
      <img src="{{ img_url }}" alt="{{ article.title }}" loading="lazy" width="800" height="400">
    </figure>
  {% endif %}

  <div class="vl-article-products">
    {% for widgetDrop in widget_lists.article-list.widgets %}
      {% widget widgetDrop %}
    {% endfor %}
  </div>

  <div class="vl-related-articles">
    <h2>Читайте также</h2>
    <div class="vl-related-grid">
      {% assign counter = 0 %}
      {% for art in blogs.blog.articles %}
        {% if art.id != article.id and counter < 4 %}
          <a href="{{ art.url }}" class="vl-related-card">
            <span class="vl-related-title">{{ art.title }}</span>
            <span class="vl-related-date">{{ art.published_at | date: "%d.%m.%Y" }}</span>
          </a>
          {% assign counter = counter | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <a href="/" class="vl-back-link">← Вернуться на главную</a>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Montserrat:wght@400;500;600;700&display=swap');

  .vl-article-page,
  .vl-article-page * { box-sizing: border-box; }

  .vl-article-page {
    width: min(100% - 40px, 1000px);
    margin: 0 auto;
    padding: 64px 0;
    background: #fff;
    color: #000;
    font-family: 'Montserrat', sans-serif;
  }

  .vl-article-title {
    margin: 0 0 16px;
    font-family: 'Playfair Display', serif;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  .vl-article-meta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 40px;
    color: #777;
    font-size: 13px;
  }

  .vl-article-cover { margin: 0 0 40px; }

  .vl-article-cover img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #000;
    border-radius: 12px;
  }

  .vl-article-products {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid #000;
  }

  .vl-article-products h1,
  .vl-article-products .vl-article-title,
  .vl-article-products .vl-article-meta,
  .vl-article-products .vl-article-cover { display: none !important; }

  .vl-article-products .product-preview {
    background: #fff !important;
    border: 1px solid #000 !important;
    border-radius: 12px !important;
    box-shadow: none !important;
  }

  .vl-article-products .product-preview__title a,
  .vl-article-products .product-preview__price,
  .vl-article-products .product-preview__price-cur {
    font-family: 'Montserrat', sans-serif !important;
    color: #000 !important;
  }

  .vl-related-articles {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid #000;
  }

  .vl-related-articles h2 {
    margin: 0 0 24px;
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
  }

  .vl-related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .vl-related-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    border: 1px solid #000;
    border-radius: 12px;
    color: #000;
    text-decoration: none;
    transition: opacity .2s ease, transform .2s ease;
  }

  .vl-related-card:hover { opacity: .7; transform: translateY(-2px); }
  .vl-related-title { font-size: 16px; font-weight: 600; line-height: 1.4; }
  .vl-related-date { color: #777; font-size: 13px; }

  .vl-back-link {
    display: block;
    margin-top: 40px;
    color: #000;
    font-size: 14px;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
  }

  .vl-back-link:hover { opacity: .6; }

  @media (max-width: 768px) {
    .vl-article-page {
      width: min(100% - 30px, 1000px);
      padding: 48px 0;
    }

    .vl-article-title { font-size: 28px; }
    .vl-related-grid { grid-template-columns: 1fr; }
  }
</style>

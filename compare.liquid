<!-- СТРАНИЦА СРАВНЕНИЯ -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Montserrat:wght@400;500;600;700&display=swap');

  .vl-compare-page,
  .vl-compare-page * { box-sizing: border-box; }

  .vl-compare-page {
    width: min(100% - 40px, 1200px);
    margin: 0 auto;
    padding: 64px 0;
    background: #fff;
    color: #000;
    font-family: 'Montserrat', sans-serif;
  }

  .vl-compare-title {
    margin: 0 0 40px;
    font-family: 'Playfair Display', serif;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  .vl-compare-title::after {
    content: '';
    display: block;
    width: 80px;
    height: 2px;
    margin: 16px auto 0;
    background: #000;
  }

  .vl-compare-wrapper {
    overflow-x: auto;
    padding: 24px;
    border: 1px solid #000;
    border-radius: 12px;
    background: #fff;
  }

  .vl-compare-wrapper .compare-title,
  .vl-compare-wrapper h2,
  .vl-compare-wrapper .heading { display: none !important; }

  .vl-compare-remove-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 8px;
    margin-bottom: 16px;
  }

  .vl-compare-remove-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
    padding: 8px 10px;
    border: 1px solid #000;
    background: #fff;
  }

  .vl-compare-remove-name {
    min-width: 0;
    overflow: hidden;
    color: #000;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .vl-compare-remove {
    display: inline-flex;
    flex: 0 0 28px;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid #000;
    background: #fff;
    color: #000;
    cursor: pointer;
    font-family: 'Montserrat', sans-serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 1;
    transition: background .2s ease, color .2s ease;
  }

  .vl-compare-remove:hover,
  .vl-compare-remove:focus-visible {
    background: #000;
    color: #fff;
  }

  .vl-compare-remove:focus-visible {
    outline: 2px solid #5E8C31;
    outline-offset: 2px;
  }

  .vl-compare-table {
    width: 100%;
    border-collapse: collapse;
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    color: #000;
  }

  .vl-compare-table th,
  .vl-compare-table td {
    padding: 12px;
    border: 1px solid #000;
    text-align: center;
    vertical-align: middle;
  }

  .vl-compare-table th {
    font-weight: 600;
    background: #f7f7f5;
  }

  .vl-compare-table .compare-remove:hover { opacity: .6; }

  .vl-compare-table .compare-image img {
    max-width: 100px;
    height: auto;
    border: 1px solid #000;
    border-radius: 8px;
  }

  .vl-compare-table .compare-title-link {
    font-weight: 600;
    color: #000;
    text-decoration: none;
  }

  .vl-compare-table .compare-title-link:hover { opacity: .6; }

  .vl-compare-table .compare-price {
    font-size: 18px;
    font-weight: 700;
  }

  .vl-compare-table .compare-btn,
  .vl-compare-empty .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 20px;
    border: 2px solid #000;
    border-radius: 30px;
    background: transparent;
    color: #000;
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background .2s ease, color .2s ease;
  }

  .vl-compare-table .compare-btn:hover,
  .vl-compare-empty .btn:hover {
    background: #000;
    color: #fff;
  }

  .vl-compare-empty {
    padding: 48px 20px;
    text-align: center;
  }

  .vl-compare-empty p {
    margin: 0 0 24px;
    color: #555;
    font-size: 16px;
  }

  .vl-compare-back {
    display: block;
    margin-top: 40px;
    color: #000;
    font-size: 14px;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
  }

  .vl-compare-back:hover { opacity: .6; }

  @media (max-width: 768px) {
    .vl-compare-page {
      width: min(100% - 30px, 1200px);
      padding: 48px 0;
    }

    .vl-compare-title { font-size: 28px; margin-bottom: 32px; }
    .vl-compare-wrapper { padding: 12px; }
    .vl-compare-table th,
    .vl-compare-table td { padding: 8px; font-size: 12px; }
  }
</style>

<section class="vl-compare-page">
  <h1 class="vl-compare-title">Сравнение</h1>

  <div class="vl-compare-wrapper">
    {% if products.size > 0 %}
      <div class="vl-compare-remove-list" aria-label="Удалить товары из сравнения">
        {% for product in products %}
          <div class="vl-compare-remove-item">
            <span class="vl-compare-remove-name" title="{{ product.title }}">{{ product.title }}</span>
            <button
              type="button"
              class="vl-compare-remove"
              data-compare-delete="{{ product.id }}"
              aria-label="Удалить {{ product.title }} из сравнения">
              ×
            </button>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% for widgetDrop in widget_lists.compare-list.widgets %}
      {% widget widgetDrop %}
    {% endfor %}
  </div>

  <a href="/" class="vl-compare-back">← Вернуться к покупкам</a>
</section>

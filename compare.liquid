<!-- СТРАНИЦА СРАВНЕНИЯ -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Montserrat:wght@400;500;600;700&display=swap');

  .vl-compare-page,
  .vl-compare-page * { box-sizing: border-box; }

  .vl-compare-page {
    width: min(100% - 40px, 1200px);
    margin: 0 auto;
    padding: 32px 0;
    background: #fff;
    color: #000;
    font-family: 'Montserrat', sans-serif;
  }

  .vl-compare-title {
    margin: 0 0 24px;
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  .vl-compare-title::after {
    content: '';
    display: block;
    width: 64px;
    height: 2px;
    margin: 10px auto 0;
    background: #000;
  }

  .vl-compare-wrapper {
    overflow-x: auto;
    background: #fff;
  }

  .vl-compare-wrapper .compare-title,
  .vl-compare-wrapper h2,
  .vl-compare-wrapper .heading { display: none !important; }

  .vl-compare-widget .layout {
    --layout-pt: 0 !important;
    --layout-pb: 0 !important;
  }

  .vl-compare-widget .layout__content {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  .vl-compare-widget .grid-list {
    --grid-list-row-gap: 0px !important;
  }

  .vl-compare-widget table {
    border-collapse: collapse !important;
  }

  .vl-compare-widget th,
  .vl-compare-widget td {
    padding-top: 7px !important;
    padding-bottom: 7px !important;
    line-height: 1.3 !important;
  }

  .vl-compare-remove-list {
    display: none;
  }

  .vl-compare-remove-item {
    display: contents;
  }

  .vl-compare-remove-name {
    display: none;
  }

  .vl-compare-remove {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 20;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, .94);
    color: #000;
    cursor: pointer;
    font-family: 'Montserrat', sans-serif;
    font-size: 24px;
    font-weight: 400;
    line-height: 1;
    box-shadow: 0 1px 6px rgba(0, 0, 0, .12);
    transition: background .2s ease, color .2s ease, transform .2s ease;
  }

  .vl-compare-remove:hover {
    background: #000;
    color: #fff;
    transform: scale(1.05);
  }

  .vl-compare-remove:focus-visible {
    background: #000;
    color: #fff;
    outline: 2px solid #5E8C31;
    outline-offset: 2px;
  }

  .vl-compare-card-target {
    position: relative !important;
  }

  .vl-compare-table {
    width: 100%;
    border-collapse: collapse;
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    color: #000;
  }

  .vl-compare-table th,
  .vl-compare-table td {
    padding: 8px;
    border: 1px solid #000;
    text-align: center;
    vertical-align: middle;
  }

  .vl-compare-table th {
    font-weight: 600;
    background: #f7f7f5;
  }

  .vl-compare-table .compare-remove:hover { opacity: .6; }

  .vl-compare-table .compare-image img {
    max-width: 100px;
    height: auto;
    border: 1px solid #000;
    border-radius: 8px;
  }

  .vl-compare-table .compare-title-link {
    font-weight: 600;
    color: #000;
    text-decoration: none;
  }

  .vl-compare-table .compare-title-link:hover { opacity: .6; }

  .vl-compare-table .compare-price {
    font-size: 18px;
    font-weight: 700;
  }

  .vl-compare-table .compare-btn,
  .vl-compare-empty .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 20px;
    border: 2px solid #000;
    border-radius: 30px;
    background: transparent;
    color: #000;
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background .2s ease, color .2s ease;
  }

  .vl-compare-table .compare-btn:hover,
  .vl-compare-empty .btn:hover {
    background: #000;
    color: #fff;
  }

  .vl-compare-empty {
    padding: 32px 20px;
    text-align: center;
  }

  .vl-compare-empty p {
    margin: 0 0 20px;
    color: #555;
    font-size: 16px;
  }

  .vl-compare-back {
    display: block;
    margin-top: 24px;
    color: #000;
    font-size: 14px;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
  }

  .vl-compare-back:hover { opacity: .6; }

  @media (max-width: 768px) {
    .vl-compare-page {
      width: min(100% - 30px, 1200px);
      padding: 24px 0;
    }

    .vl-compare-title { font-size: 28px; margin-bottom: 20px; }
    .vl-compare-wrapper { padding: 0; }
    .vl-compare-table th,
    .vl-compare-table td { padding: 6px; font-size: 12px; }

    .vl-compare-remove {
      top: 6px;
      right: 6px;
      width: 30px;
      height: 30px;
    }
  }
</style>

<section class="vl-compare-page">
  <h1 class="vl-compare-title">Сравнение</h1>

  <div class="vl-compare-wrapper">
    {% if products.size > 0 %}
      <div class="vl-compare-remove-list" aria-label="Удалить товары из сравнения">
        {% for product in products %}
          <div class="vl-compare-remove-item">
            <span class="vl-compare-remove-name">{{ product.title }}</span>
            <button
              type="button"
              class="vl-compare-remove"
              data-compare-delete="{{ product.id }}"
              aria-label="Удалить {{ product.title }} из сравнения">
              ×
            </button>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <div class="vl-compare-widget">
      {% for widgetDrop in widget_lists.compare-list.widgets %}
        {% widget widgetDrop %}
      {% endfor %}
    </div>
  </div>

  <a href="/" class="vl-compare-back">← Вернуться к покупкам</a>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var page = document.querySelector('.vl-compare-page');
    if (!page) return;

    function findCardByProductId(button) {
      var id = button.getAttribute('data-compare-delete');
      if (!id) return null;

      var selectors = [
        '[data-product-id="' + id + '"]',
        '[data-product="' + id + '"]',
        '.compare-product[data-id="' + id + '"]',
        '.compare-item[data-id="' + id + '"]'
      ];

      for (var i = 0; i < selectors.length; i += 1) {
        var candidate = page.querySelector(selectors[i]);
        if (candidate && candidate !== button && !candidate.closest('.vl-compare-remove-list')) {
          return candidate;
        }
      }

      var title = button.parentElement && button.parentElement.querySelector('.vl-compare-remove-name');
      var titleText = title ? title.textContent.trim() : '';
      if (!titleText) return null;

      var links = page.querySelectorAll('a');
      for (var j = 0; j < links.length; j += 1) {
        if (links[j].textContent.trim() !== titleText) continue;

        var card = links[j].closest('td, th, .compare-product, .compare-item, [class*="compare"]');
        if (card && !card.closest('.vl-compare-remove-list')) return card;
      }

      return null;
    }

    function attachRemoveButtons() {
      var buttons = page.querySelectorAll('.vl-compare-remove[data-compare-delete]');
      for (var i = 0; i < buttons.length; i += 1) {
        var button = buttons[i];
        if (button.dataset.vlCompareAttached === '1') continue;

        var card = findCardByProductId(button);
        if (!card) continue;

        card.classList.add('vl-compare-card-target');
        card.appendChild(button);
        button.dataset.vlCompareAttached = '1';
      }
    }

    attachRemoveButtons();

    var observer = new MutationObserver(function () {
      attachRemoveButtons();
    });

    observer.observe(page.querySelector('.vl-compare-widget') || page, {
      childList: true,
      subtree: true
    });

    if (typeof EventBus !== 'undefined' && typeof EventBus.subscribe === 'function') {
      EventBus.subscribe('remove_item:insales:compares', function () {
        window.location.reload();
      });
    }
  });
</script>

<!-- КОРЗИНА — V2 STANDARD -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Montserrat:wght@300;400;500;600;700&family=Roboto:wght@400;500;700&display=swap');
  .vl-cart,.vl-cart *{box-sizing:border-box}.vl-cart{width:min(100% - 40px,1240px);margin:0 auto;padding:80px 0;background:#fff;color:#0a0a0a;font-family:'Roboto',Arial,sans-serif}.vl-cart h1,.vl-cart .cart-title{margin:0 0 40px;font-family:'Playfair Display',serif;font-size:clamp(38px,5vw,58px);line-height:1.02;letter-spacing:-.7px;text-transform:uppercase}.vl-cart .cart-item,.vl-cart .cart-table tr,.vl-cart .cart-items>div,.vl-cart .item{display:grid!important;grid-template-columns:100px minmax(0,1fr) auto auto auto!important;gap:20px!important;align-items:center!important;margin-bottom:16px!important;padding:20px!important;border:1px solid #000!important;border-radius:14px!important;background:#fff!important;box-shadow:none!important}.vl-cart .cart-item__image,.vl-cart .cart-item__photo,.vl-cart td img{width:100px!important;height:100px!important;object-fit:contain!important;border:1px solid #ddd!important;border-radius:8px!important;background:#f7f7f5!important}.vl-cart .cart-item__title,.vl-cart .cart-item__name,.vl-cart td a{color:#000!important;font:600 14px 'Montserrat',sans-serif!important;text-decoration:none!important}.vl-cart .cart-item__price,.vl-cart .price,.vl-cart .cart-total__value,.vl-cart .total-value{color:#000!important;font-family:'Montserrat',sans-serif!important;font-weight:700!important}.vl-cart .cart-item__price,.vl-cart .price{font-size:16px!important}.vl-cart .cart-item__quantity,.vl-cart .quantity{display:flex;align-items:center;gap:8px}.vl-cart .cart-item__quantity input,.vl-cart .quantity input{width:58px!important;min-height:40px;border:1px solid #000!important;border-radius:3px!important;background:#fff!important;text-align:center}.vl-cart .cart-item__quantity button,.vl-cart .quantity button,.vl-cart .quantity-btn{width:34px!important;height:34px!important;border:1px solid #000!important;border-radius:50%!important;background:#fff!important;color:#000!important}.vl-cart .cart-item__remove,.vl-cart .remove-btn,.vl-cart a[data-remove]{color:#000!important;border-bottom:1px solid #000!important;text-decoration:none!important;font-size:12px!important;letter-spacing:1px;text-transform:uppercase}.vl-cart .cart-total,.vl-cart .total,.vl-cart .cart-summary{margin-top:35px;padding:25px 0;border-top:1px solid #000;text-align:right}.vl-cart .cart-total__value,.vl-cart .total-value{font-size:28px!important}.vl-cart .cart-checkout-btn,.vl-cart .checkout-btn,.vl-cart a[href*="checkout"]{display:inline-flex!important;align-items:center;justify-content:center;min-height:52px;padding:0 28px!important;border:1px solid #000!important;border-radius:3px!important;background:#000!important;color:#fff!important;font:600 12px 'Montserrat',sans-serif!important;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none!important}.vl-cart .cart-checkout-btn:hover,.vl-cart .checkout-btn:hover,.vl-cart a[href*="checkout"]:hover{background:#fff!important;color:#000!important}.vl-cart .cart-continue,.vl-cart a[href*="collection"],.vl-cart a[href="/"]{color:#000!important;text-decoration:none!important}.vl-cart .special-products{margin-top:60px;padding-top:45px;border-top:1px solid #000}.vl-cart .special-products__title{margin:0 0 25px;font-family:'Playfair Display',serif!important;font-size:42px!important}.vl-cart .product-preview{height:100%;padding:20px;border:1px solid #000!important;border-radius:14px!important;background:#fff!important;box-shadow:none!important}.vl-cart .product-preview__title{text-align:center}.vl-cart .product-preview__title a{color:#000!important;font-family:'Montserrat',sans-serif!important;text-decoration:none!important}.vl-cart .product-preview__price{text-align:center;font-family:'Montserrat',sans-serif;font-weight:700}.vl-cart .product-preview__area-bottom{display:flex;justify-content:flex-end;gap:12px}.vl-cart .product-preview__controls-left .button,.vl-cart .add-cart-counter__btn,.vl-cart .product-preview__controls .button{border:0!important;background:transparent!important;color:#000!important}.vl-cart .cart-empty,.vl-cart .empty-cart{padding:60px 20px;text-align:center}@media(max-width:768px){.vl-cart{width:min(100% - 30px,1240px);padding:55px 0}.vl-cart .cart-item,.vl-cart .cart-table tr,.vl-cart .cart-items>div,.vl-cart .item{grid-template-columns:60px minmax(0,1fr)!important;gap:12px!important;padding:14px!important}.vl-cart .cart-item__image,.vl-cart .cart-item__photo,.vl-cart td img{width:60px!important;height:60px!important;grid-row:span 2}.vl-cart .cart-total,.vl-cart .total,.vl-cart .cart-summary{text-align:left}.vl-cart .cart-checkout-btn,.vl-cart .checkout-btn,.vl-cart a[href*="checkout"]{width:100%}}
</style>
<section class="vl-cart">
  {% for widgetDrop in widget_lists.cart-list.widgets %}
    {% widget widgetDrop %}
  {% endfor %}
</section>
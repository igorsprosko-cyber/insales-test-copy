<!-- СТРАНИЦА ТОВАРА — V2 STANDARD -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Montserrat:wght@300;400;500;600;700&family=Roboto:wght@400;500;700&display=swap');
  .vl-product-wrapper,
  .vl-product-wrapper * { box-sizing: border-box; }
  .vl-product-wrapper {
    width: min(100% - 40px, 1240px);
    margin: 0 auto;
    padding: 80px 0;
    background: #fff;
    color: #0a0a0a;
    font-family: 'Roboto', Arial, sans-serif;
  }
  .vl-product-wrapper .product-title {
    margin: 0 0 35px;
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 5vw, 58px);
    line-height: 1.02;
    letter-spacing: -.7px;
    text-transform: uppercase;
  }
  .vl-product-wrapper .product__image,
  .vl-product-wrapper .product-image,
  .vl-product-wrapper .product-photo,
  .vl-product-wrapper .product__photo,
  .vl-product-wrapper .product-gallery,
  .vl-product-wrapper .product__gallery,
  .vl-product-wrapper .product__media,
  .vl-product-wrapper .product-media,
  .vl-product-wrapper .product__main-image,
  .vl-product-wrapper .product-main-image,
  .vl-product-wrapper .product__image-container,
  .vl-product-wrapper .product-image-container,
  .vl-product-wrapper .product__picture,
  .vl-product-wrapper .product-picture,
  .vl-product-wrapper .product__cover,
  .vl-product-wrapper .product-cover {
    max-width: 100%;
    overflow: hidden;
    border: 1px solid #000 !important;
    border-radius: 14px !important;
    background: #fff;
  }
  .vl-product-wrapper .product__image img,
  .vl-product-wrapper .product-image img,
  .vl-product-wrapper .product-photo img,
  .vl-product-wrapper .product__photo img,
  .vl-product-wrapper .product-gallery img,
  .vl-product-wrapper .product__gallery img,
  .vl-product-wrapper .product__media img,
  .vl-product-wrapper .product-media img,
  .vl-product-wrapper .product__main-image img,
  .vl-product-wrapper .product-main-image img,
  .vl-product-wrapper .product__image-container img,
  .vl-product-wrapper .product-image-container img,
  .vl-product-wrapper .product__picture img,
  .vl-product-wrapper .product-picture img,
  .vl-product-wrapper .product__cover img,
  .vl-product-wrapper .product-cover img {
    display: block;
    width: 100%;
    max-height: 620px;
    object-fit: contain;
    margin: 0 auto;
  }
  .vl-product-wrapper .product__price,
  .vl-product-wrapper .product-price,
  .vl-product-wrapper .price {
    margin: 24px 0;
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 700;
    color: #000;
  }
  .vl-product-wrapper .product__price .old-price,
  .vl-product-wrapper .product-price .old-price,
  .vl-product-wrapper .price .old-price {
    margin-left: 10px;
    color: #777;
    font-size: .65em;
    font-weight: 400;
    text-decoration: line-through;
  }
  .vl-product-wrapper .product__cart,
  .vl-product-wrapper .product__buy,
  .vl-product-wrapper .add-cart,
  .vl-product-wrapper .btn-buy,
  .vl-product-wrapper .product__add-to-cart > button,
  .vl-product-wrapper .product__buy-button {
    min-height: 52px;
    padding: 0 28px;
    border: 1px solid #000 !important;
    border-radius: 3px !important;
    background: #000 !important;
    color: #fff !important;
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: .25s ease;
  }
  .vl-product-wrapper .product__cart:hover,
  .vl-product-wrapper .product__buy:hover,
  .vl-product-wrapper .add-cart:hover,
  .vl-product-wrapper .btn-buy:hover,
  .vl-product-wrapper .product__add-to-cart > button:hover,
  .vl-product-wrapper .product__buy-button:hover {
    background: #fff !important;
    color: #000 !important;
    transform: translateY(-2px);
  }
  .vl-product-wrapper .product__description,
  .vl-product-wrapper .product-description,
  .vl-product-wrapper .product__content,
  .vl-product-wrapper .product__characteristics,
  .vl-product-wrapper .characteristics,
  .vl-product-wrapper .product__reviews,
  .vl-product-wrapper .reviews,
  .vl-product-wrapper .product__properties,
  .vl-product-wrapper .properties {
    margin: 35px 0;
    color: #333;
    font-size: 16px;
    line-height: 1.7;
  }
  .vl-product-wrapper h2,
  .vl-product-wrapper .product__description h2,
  .vl-product-wrapper .product-description h2,
  .vl-product-wrapper .product__content h2,
  .vl-product-wrapper .product__characteristics h2,
  .vl-product-wrapper .characteristics h2,
  .vl-product-wrapper .product__reviews h2,
  .vl-product-wrapper .reviews h2 {
    margin: 40px 0 18px;
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.05;
  }
  .vl-product-wrapper h3 { font-family: 'Montserrat', sans-serif; font-size: 20px; }
  .vl-product-wrapper table { width: 100%; border-collapse: collapse; margin: 25px 0; }
  .vl-product-wrapper th,
  .vl-product-wrapper td { padding: 12px; border: 1px solid #000; text-align: left; font-size: 14px; }
  .vl-product-wrapper th { background: #f7f7f5; font-weight: 600; }
  .vl-product-wrapper .product__actions,
  .vl-product-wrapper .product-actions { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 25px; }
  .vl-product-wrapper .product__actions a,
  .vl-product-wrapper .product-actions a,
  .vl-back-link { color: #000; text-decoration: none; font-family: 'Montserrat', sans-serif; }
  .vl-product-wrapper .breadcrumb,
  .vl-product-wrapper .breadcrumbs { margin-bottom: 25px; color: #777; font-size: 13px; }
  .vl-auto-description { margin-top: 50px; padding: 35px; border: 1px solid #000; background: #f7f7f5; }
  .vl-auto-description p,
  .vl-auto-description li { color: #333; font-size: 15px; line-height: 1.7; }
  .vl-auto-description h2 { margin-top: 30px; padding-bottom: 10px; border-bottom: 1px solid #000; }
  .vl-back-link { display: block; margin-top: 45px; text-align: center; font-size: 13px; letter-spacing: 1.5px; text-transform: uppercase; }
  @media (max-width: 768px) {
    .vl-product-wrapper { width: min(100% - 30px, 1240px); padding: 55px 0; }
    .vl-product-wrapper .product-title { margin-bottom: 25px; font-size: 34px; }
    .vl-auto-description { padding: 24px; }
    .vl-product-wrapper .product__cart,
    .vl-product-wrapper .product__buy,
    .vl-product-wrapper .add-cart,
    .vl-product-wrapper .btn-buy,
    .vl-product-wrapper .product__add-to-cart > button,
    .vl-product-wrapper .product__buy-button { width: 100%; }
  }
</style>

<div class="vl-product-wrapper">
<!-- ===== МИКРОРАЗМЕТКА SCHEMA.ORG ДЛЯ ТОВАРА (ПОЛНАЯ B2B С АВТО-ХАРАКТЕРИСТИКАМИ) ===== -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "{{ product.title | escape }}",
  "description": "{{ product.description | strip_html | strip_newlines | escape | truncate: 300 }}",
  "sku": "{{ product.variants.first.sku | escape }}",
  "brand": {"@type": "Brand", "name": "Veles Legs"},
  "manufacturer": {"@type": "Organization", "name": "ВЕЛЕС, ФК, ООО", "url": "https://veles-legs.ru"},
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "RUB",
    "lowPrice": "{{ product.variants.first.price | money_without_currency | replace: ',', '.' | replace: ' ', '' }}",
    "highPrice": "{{ product.variants.last.price | money_without_currency | replace: ',', '.' | replace: ' ', '' }}",
    "offerCount": "{{ product.variants.size }}",
    "availability": "{% if product.variants.first.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "url": "https://veles-legs.ru{{ product.url }}",
    "seller": {"@type": "Organization", "name": "Veles Legs"}
  },
  "image": ["{% if product.images.first.original_url %}{{ product.images.first.original_url }}{% elsif product.default_image.original_url %}{{ product.default_image.original_url }}{% else %}https://veles-legs.ru/assets/no-image.jpg{% endif %}"],
  "additionalProperty": [
    {"@type": "PropertyValue", "name": "Минимальный заказ", "value": "От 100 штук"},
    {"@type": "PropertyValue", "name": "Тип продажи", "value": "Опт"}
    {% for characteristic in product.characteristics %},
    {"@type": "PropertyValue", "name": "{{ characteristic.property.title | escape }}", "value": "{{ characteristic.title | escape }}"}
    {% endfor %}
  ]
}
</script>

<h1 class="product-title">{{ product.title }}</h1>

{% for widgetDrop in widget_lists.product-list.widgets %}
  {% widget widgetDrop %}
{% endfor %}

{% if product.characteristics.size > 0 %}
<div class="vl-auto-description">
  <h2>Общее описание</h2>
  <p><strong>{{ product.title }}</strong> — мебельная опора от российского производителя Veles Legs, предназначенная для диванов, кроватей, кресел и корпусной мебели.</p>
  <h2>Ключевые характеристики</h2>
  <ul>{% for characteristic in product.characteristics %}<li><strong>{{ characteristic.property.title }}:</strong> {{ characteristic.title }}</li>{% endfor %}</ul>
  <h2>Преимущества</h2>
  <ul><li>Качественные материалы и сборка.</li><li>Надёжная фиксация и простой монтаж.</li><li>Подходит для современных и классических интерьеров.</li><li>Возможность изготовления нестандартных размеров и исполнений.</li></ul>
</div>
{% endif %}

<a href="/" class="vl-back-link" aria-label="Вернуться на главную страницу">← Вернуться на главную</a>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.product__cart, .product__buy, .add-cart, .btn-buy, .product__add-to-cart button, .product__buy-button').forEach(function(btn) {
    if (!btn.hasAttribute('aria-label')) btn.setAttribute('aria-label', 'Добавить товар в корзину');
  });
  document.querySelectorAll('.product__actions a[href*="favorite"]').forEach(function(link) {
    if (!link.hasAttribute('aria-label')) link.setAttribute('aria-label', 'Добавить в избранное');
  });
  document.querySelectorAll('.product__actions a[href*="compare"]').forEach(function(link) {
    if (!link.hasAttribute('aria-label')) link.setAttribute('aria-label', 'Добавить к сравнению');
  });
  var productImg = document.querySelector('.vl-product-wrapper .product__image img, .vl-product-wrapper .product-image img, .vl-product-wrapper .product-photo img');
  if (productImg) { productImg.loading = 'eager'; productImg.setAttribute('fetchpriority', 'high'); }
});
</script>
{% comment %}
  VELES LEGS — V2.1 TEST LAYER / corrected
  This file is the single test layer used on the copied homepage.
  Does NOT replace or modify the existing calculator logic.
  V2 DESIGN RULE: strict geometry, zero rounded corners.
  V2 INTERACTION RULE: primary accent hover is green for all CTA buttons.
{% endcomment %}

{% assign VL_CATALOG_URL = '/collection/all' %}
{% assign VL_WOOD_URL = '/collection/derevyannye-nozhki-dlya-mebeli' %}
{% assign VL_METAL_URL = '/collection/metallicheskie-nozhki-dlya-mebeli' %}
{% assign VL_FURNITURE_URL = '/collection/new' %}
{% assign VL_CUSTOM_URL = '/collection/raboty-na-zakaz' %}
{% assign VL_HITS_URL = '/collection/hits' %}
{% assign VL_SALE_URL = '/collection/aktsii' %}
{% assign VL_LIGHT_URL = 'https://veleslight.ru/' %}
{% assign VL_PHONE_URL = 'tel:+74992905200' %}

<style>
  :root {
    --vl21-black: #0a0a0a;
    --vl21-white: #fff;
    --vl21-soft: #f5f5f2;
    --vl21-line: #d8d8d4;
    --vl21-green: #2f9e44;
    --vl21-max: 1240px;
  }

  .vl21-layer,
  .vl21-layer * { box-sizing: border-box; }

  .vl21-layer,
  .vl21-layer * { border-radius: 0 !important; }

  .vl-v2-hero,
  .vl-v2-hero * { border-radius: 0 !important; }

  /* Remove the old duplicate homepage blocks. The V2 layer replaces them. */
  .vl-v2-section:has(.vl-v2-category-grid) { display: none !important; }
  .vl-v2-final { display: none !important; }

  /* Calculator: keep the existing logic, but force its visual controls to the same 90-degree geometry. */
  .vl-v2,
  .vl-v2 * { border-radius: 0 !important; }
  .vl-v2 .vl-tab,
  .vl-v2 .vl-column,
  .vl-v2 .vl-select-group select,
  .vl-v2 .vl-select-group input,
  .vl-v2 .vl-select-group textarea,
  .vl-v2 .vl-calc-result,
  .vl-v2 button,
  .vl-v2 input,
  .vl-v2 select,
  .vl-v2 textarea { border-radius: 0 !important; }

  /* Keep the same green interaction rule on the original V2 hero buttons. */
  .vl-v2 .vl-v2-btn:hover {
    background: var(--vl21-green) !important;
    border-color: var(--vl21-green) !important;
    color: #fff !important;
  }

  .vl21-layer {
    width: 100%;
    color: var(--vl21-black);
    background: var(--vl21-white);
    font-family: Arial, Helvetica, sans-serif;
  }

  .vl21-wrap {
    width: min(calc(100% - 40px), var(--vl21-max));
    margin: 0 auto;
  }

  .vl21-section { padding: 88px 0; }

  .vl21-section--soft {
    background: var(--vl21-soft);
    border-top: 1px solid var(--vl21-line);
    border-bottom: 1px solid var(--vl21-line);
  }

  .vl21-kicker {
    margin-bottom: 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .vl21-title {
    margin: 0;
    max-width: 760px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(38px, 6vw, 70px);
    line-height: .98;
    letter-spacing: -1.5px;
  }

  .vl21-copy {
    max-width: 680px;
    margin: 20px 0 0;
    color: #444;
    font-size: 17px;
    line-height: 1.7;
  }

  .vl21-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .vl21-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 25px;
    border: 1px solid #000;
    background: #000;
    color: #fff !important;
    text-decoration: none !important;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    transition: .2s ease;
  }

  .vl21-btn:hover {
    background: var(--vl21-green);
    border-color: var(--vl21-green);
    color: #fff !important;
    transform: translateY(-2px);
  }

  .vl21-btn--light {
    background: #fff;
    color: #000 !important;
  }

  /* Universal V2 CTA rule: light buttons use the same green hover as the catalog CTA. */
  .vl21-btn--light:hover {
    background: var(--vl21-green);
    border-color: var(--vl21-green);
    color: #fff !important;
  }

  .vl21-catalog-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 42px;
  }

  .vl21-catalog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .vl21-catalog-card {
    min-height: 250px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px;
    border: 1px solid #000;
    background: #fff;
    color: #000;
    text-decoration: none !important;
    transition: .25s ease;
  }

  .vl21-catalog-card:hover {
    background: #000;
    color: #fff;
    transform: translateY(-4px);
  }

  .vl21-catalog-num {
    font-family: Georgia, serif;
    font-size: 30px;
    color: #aaa;
  }

  .vl21-catalog-card h3 {
    margin: 0 0 8px;
    font-family: Georgia, serif;
    font-size: 27px;
  }

  .vl21-catalog-card p {
    margin: 0;
    color: #555;
    font-size: 13px;
    line-height: 1.5;
  }

  .vl21-catalog-card:hover p { color: #ccc; }

  .vl21-catalog-arrow {
    margin-top: 20px;
    font-size: 20px;
  }

  .vl21-catalog-main {
    display: block;
    margin-top: 18px;
    padding: 22px 25px;
    border: 1px solid #000;
    background: #000;
    color: #fff !important;
    text-decoration: none !important;
    transition: .2s ease;
  }

  .vl21-catalog-main:hover {
    background: var(--vl21-green);
    border-color: var(--vl21-green);
    color: #fff !important;
    transform: translateY(-2px);
  }

  .vl21-catalog-main strong {
    display: block;
    margin-bottom: 7px;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .vl21-catalog-main span {
    display: block;
    color: #ccc;
    font-size: 14px;
  }

  .vl21-catalog-main:hover span { color: #fff; }

  .vl21-light {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    min-height: 420px;
    border: 1px solid #000;
    background: #000;
    color: #fff;
  }

  .vl21-light-copy { padding: 55px; }
  .vl21-light-copy .vl21-kicker { color: #aaa; }
  .vl21-light-copy .vl21-title { color: #fff; }
  .vl21-light-copy .vl21-copy { color: #c7c7c7; }

  .vl21-light-visual {
    position: relative;
    min-height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background:
      linear-gradient(rgba(255,255,255,.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.06) 1px, transparent 1px),
      #111;
    background-size: 46px 46px;
  }

  .vl21-lamp-orbit {
    width: 230px;
    height: 230px;
    border: 1px solid rgba(255,255,255,.35);
    position: relative;
  }

  .vl21-lamp-orbit::before,
  .vl21-lamp-orbit::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: 1px;
    height: 100%;
    background: rgba(255,255,255,.16);
    transform: translateX(-50%);
  }

  .vl21-lamp-orbit::after { transform: translateX(-50%) rotate(90deg); }

  .vl21-lamp-core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 70px;
    height: 110px;
    transform: translate(-50%, -50%);
    background: #eee;
    box-shadow: 0 0 55px rgba(255,255,255,.65);
  }

  .vl21-lamp-core::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -55px;
    width: 5px;
    height: 58px;
    transform: translateX(-50%);
    background: #eee;
  }

  .vl21-lamp-core::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -12px;
    width: 105px;
    height: 10px;
    transform: translateX(-50%);
    background: #eee;
  }

  .vl-v2-hero h1 { max-width: 820px; }
  .vl-v2-hero h1 span { letter-spacing: 2px; }

  @media (max-width: 900px) {
    .vl21-catalog-grid { grid-template-columns: repeat(2, 1fr); }
    .vl21-light { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .vl21-wrap { width: min(calc(100% - 28px), var(--vl21-max)); }
    .vl21-section { padding: 62px 0; }
    .vl21-catalog-head { align-items: start; flex-direction: column; }
    .vl21-catalog-grid { grid-template-columns: 1fr; }
    .vl21-light-copy { padding: 35px 25px; }
    .vl21-light-visual { min-height: 300px; }
  }
</style>

<div class="vl21-layer" id="vl21-layer">

  <section class="vl21-section vl21-section--soft" id="vl21-catalog">
    <div class="vl21-wrap">
      <div class="vl21-catalog-head">
        <div>
          <div class="vl21-kicker">01 / Каталог продукции</div>
          <h2 class="vl21-title">Вся продукция — в одном каталоге</h2>
          <p class="vl21-copy">
            Выбирайте направление, готовое изделие или решение под индивидуальную задачу.
          </p>
        </div>
      </div>

      <div class="vl21-catalog-grid">
        <a class="vl21-catalog-card" href="{{ VL_WOOD_URL }}">
          <span class="vl21-catalog-num">01</span>
          <div>
            <h3>Деревянные опоры</h3>
            <p>Дуб, бук, ясень. Круглые, квадратные и резные модели.</p>
            <div class="vl21-catalog-arrow">→</div>
          </div>
        </a>

        <a class="vl21-catalog-card" href="{{ VL_METAL_URL }}">
          <span class="vl21-catalog-num">02</span>
          <div>
            <h3>Металлические опоры</h3>
            <p>Стандартные и регулируемые решения для мебели.</p>
            <div class="vl21-catalog-arrow">→</div>
          </div>
        </a>

        <a class="vl21-catalog-card" href="{{ VL_FURNITURE_URL }}">
          <span class="vl21-catalog-num">03</span>
          <div>
            <h3>Мебельная фурнитура</h3>
            <p>Крепления, заглушки, подпятники и дополнительные элементы.</p>
            <div class="vl21-catalog-arrow">→</div>
          </div>
        </a>

        <a class="vl21-catalog-card" href="{{ VL_CUSTOM_URL }}">
          <span class="vl21-catalog-num">04</span>
          <div>
            <h3>Под заказ</h3>
            <p>Нестандартные размеры, материалы и конструкции.</p>
            <div class="vl21-catalog-arrow">→</div>
          </div>
        </a>

        <a class="vl21-catalog-card" href="{{ VL_HITS_URL }}">
          <span class="vl21-catalog-num">05</span>
          <div>
            <h3>Хиты</h3>
            <p>Модели, которые чаще всего выбирают мебельные производства.</p>
            <div class="vl21-catalog-arrow">→</div>
          </div>
        </a>

        <a class="vl21-catalog-card" href="{{ VL_SALE_URL }}">
          <span class="vl21-catalog-num">06</span>
          <div>
            <h3>Акции</h3>
            <p>Специальные цены и предложения для оптовых заказчиков.</p>
            <div class="vl21-catalog-arrow">→</div>
          </div>
        </a>
      </div>

      <a class="vl21-catalog-main" href="{{ VL_CATALOG_URL }}">
        <strong>Перейти в каталог</strong>
        <span>Все товары и категории тестового магазина →</span>
      </a>
    </div>
  </section>

  <section class="vl21-section" id="vl21-light">
    <div class="vl21-wrap">
      <div class="vl21-light">
        <div class="vl21-light-copy">
          <div class="vl21-kicker">02 / Новое производство</div>
          <h2 class="vl21-title">Настольные лампы Veles Light</h2>
          <p class="vl21-copy">
            Отдельное направление собственного производства — дизайнерские настольные лампы из натурального дерева.
            Показываем его отдельно, чтобы новое производство было заметно посетителю.
          </p>
          <div class="vl21-actions">
            <a class="vl21-btn vl21-btn--light" href="{{ VL_LIGHT_URL }}" target="_blank" rel="noopener noreferrer">
              Перейти на Veles Light
            </a>
          </div>
        </div>
        <div class="vl21-light-visual" aria-hidden="true">
          <div class="vl21-lamp-orbit">
            <div class="vl21-lamp-core"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="vl21-section vl21-section--soft" id="vl21-final-cta">
    <div class="vl21-wrap">
      <div class="vl21-kicker">03 / Следующий шаг</div>
      <h2 class="vl21-title">Подберём решение под ваш проект</h2>
      <p class="vl21-copy">
        Готовые модели, оптовые партии и производство по техническому заданию.
      </p>
      <div class="vl21-actions">
        <a class="vl21-btn" href="{{ VL_CATALOG_URL }}">Перейти в каталог</a>
        <a class="vl21-btn vl21-btn--light" href="{{ VL_PHONE_URL }}">Связаться с нами</a>
      </div>
    </div>
  </section>
</div>

<script>
(function () {
  'use strict';

  var catalogUrl = {{ VL_CATALOG_URL | json }};

  function upgradeHero() {
    var hero = document.querySelector('.vl-v2-hero');
    if (!hero) return;

    var title = hero.querySelector('h1');
    if (title) {
      title.innerHTML = 'МЕБЕЛЬНЫЕ ОПОРЫ<br>ДЛЯ ФАБРИК <span>СОБСТВЕННОЕ ПРОИЗВОДСТВО · B2B · РОССИЯ</span>';
    }

    var description = hero.querySelector('.vl-v2-hero-description');
    if (description) {
      description.textContent = 'Деревянные и металлические опоры собственного производства. Готовые решения, оптовые партии и изготовление по вашему техническому заданию.';
    }

    var buttons = hero.querySelectorAll('.vl-v2-btn');
    if (buttons.length) {
      buttons[0].textContent = 'Смотреть каталог';
      buttons[0].setAttribute('href', catalogUrl);
    }
    if (buttons.length > 1) {
      buttons[1].textContent = 'Получить прайс';
      buttons[1].setAttribute('href', '/contact');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', upgradeHero);
  } else {
    upgradeHero();
  }
})();
</script>

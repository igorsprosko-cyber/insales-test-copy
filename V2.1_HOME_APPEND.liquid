{% comment %}
  VELES LEGS — V2.1 TEST LAYER
  Drop-in append for the existing index.liquid.
  Does NOT replace or modify the existing calculator logic.

  HOW TO USE:
  Paste this block at the very END of index.liquid.
  The existing page remains the base; this layer adds the new Catalog and Veles Light blocks
  and upgrades the first-screen messaging/CTA without touching calculator internals.

  IMPORTANT:
  Set VL_CATALOG_URL below to the actual standalone Catalog page URL when that page is created.
{% endcomment %}

{% assign VL_CATALOG_URL = '/page/catalog' %}

<style>
  :root {
    --vl21-black: #0a0a0a;
    --vl21-white: #fff;
    --vl21-soft: #f5f5f2;
    --vl21-line: #d8d8d4;
    --vl21-muted: #666;
    --vl21-max: 1240px;
  }

  .vl21-layer,
  .vl21-layer * { box-sizing: border-box; }

  .vl21-layer {
    width: 100%;
    color: var(--vl21-black);
    background: var(--vl21-white);
    font-family: Arial, Helvetica, sans-serif;
  }

  .vl21-wrap {
    width: min(calc(100% - 40px), var(--vl21-max));
    margin: 0 auto;
  }

  .vl21-section { padding: 88px 0; }

  .vl21-section--soft {
    background: var(--vl21-soft);
    border-top: 1px solid var(--vl21-line);
    border-bottom: 1px solid var(--vl21-line);
  }

  .vl21-kicker {
    margin-bottom: 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .vl21-title {
    margin: 0;
    max-width: 760px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(38px, 6vw, 70px);
    line-height: .98;
    letter-spacing: -1.5px;
  }

  .vl21-copy {
    max-width: 680px;
    margin: 20px 0 0;
    color: #444;
    font-size: 17px;
    line-height: 1.7;
  }

  .vl21-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .vl21-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 25px;
    border: 1px solid #000;
    background: #000;
    color: #fff !important;
    text-decoration: none !important;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    transition: .2s ease;
  }

  .vl21-btn:hover {
    background: #fff;
    color: #000 !important;
    transform: translateY(-2px);
  }

  .vl21-btn--light {
    background: #fff;
    color: #000 !important;
  }

  .vl21-btn--light:hover {
    background: #000;
    color: #fff !important;
  }

  /* Catalog */
  .vl21-catalog-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 42px;
  }

  .vl21-catalog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .vl21-catalog-card {
    min-height: 250px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px;
    border: 1px solid #000;
    background: #fff;
    text-decoration: none !important;
    transition: .25s ease;
  }

  .vl21-catalog-card:hover {
    background: #000;
    color: #fff;
    transform: translateY(-4px);
  }

  .vl21-catalog-num {
    font-family: Georgia, serif;
    font-size: 30px;
    color: #aaa;
  }

  .vl21-catalog-card h3 {
    margin: 0 0 8px;
    font-family: Georgia, serif;
    font-size: 29px;
  }

  .vl21-catalog-card p {
    margin: 0;
    color: #555;
    font-size: 13px;
    line-height: 1.5;
  }

  .vl21-catalog-card:hover p { color: #ccc; }

  .vl21-catalog-arrow {
    margin-top: 20px;
    font-size: 20px;
  }

  /* Veles Light */
  .vl21-light {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    min-height: 420px;
    border: 1px solid #000;
    background: #000;
    color: #fff;
  }

  .vl21-light-copy {
    padding: 55px;
  }

  .vl21-light-copy .vl21-kicker { color: #aaa; }

  .vl21-light-copy .vl21-title { color: #fff; }

  .vl21-light-copy .vl21-copy { color: #c7c7c7; }

  .vl21-light-visual {
    position: relative;
    min-height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background:
      radial-gradient(circle at center, rgba(255,255,255,.18), transparent 28%),
      radial-gradient(circle at center, rgba(255,255,255,.06), transparent 55%),
      #111;
  }

  .vl21-lamp-orbit {
    width: 230px;
    height: 230px;
    border: 1px solid rgba(255,255,255,.35);
    border-radius: 50%;
    position: relative;
  }

  .vl21-lamp-orbit::before,
  .vl21-lamp-orbit::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 100%;
    background: rgba(255,255,255,.16);
  }

  .vl21-lamp-orbit::after { transform: translateX(-50%) rotate(90deg); }

  .vl21-lamp-core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 70px;
    height: 110px;
    transform: translate(-50%, -50%);
    border-radius: 45% 45% 12% 12%;
    background: #eee;
    box-shadow: 0 0 55px rgba(255,255,255,.65);
  }

  .vl21-lamp-core::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -55px;
    width: 5px;
    height: 58px;
    transform: translateX(-50%);
    background: #eee;
  }

  .vl21-lamp-core::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -12px;
    width: 105px;
    height: 10px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: #eee;
  }

  /* Override hero copy while preserving its existing structure and calculator. */
  .vl-v2-hero h1 { max-width: 820px; }
  .vl-v2-hero h1 span { letter-spacing: 2px; }

  @media (max-width: 900px) {
    .vl21-catalog-grid { grid-template-columns: repeat(2, 1fr); }
    .vl21-light { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .vl21-wrap { width: min(calc(100% - 28px), var(--vl21-max)); }
    .vl21-section { padding: 62px 0; }
    .vl21-catalog-head { align-items: start; flex-direction: column; }
    .vl21-catalog-grid { grid-template-columns: 1fr; }
    .vl21-light-copy { padding: 35px 25px; }
    .vl21-light-visual { min-height: 300px; }
  }
</style>

<div class="vl21-layer" id="vl21-layer">

  <!-- =====================================================
       V2.1 CATALOG: standalone entry point
       ===================================================== -->
  <section class="vl21-section vl21-section--soft" id="vl21-catalog">
    <div class="vl21-wrap">
      <div class="vl21-catalog-head">
        <div>
          <div class="vl21-kicker">01 / Каталог продукции</div>
          <h2 class="vl21-title">Вся продукция — в одном каталоге</h2>
          <p class="vl21-copy">
            Не отправляем посетителя сразу в одну категорию. Сначала он выбирает направление,
            затем конкретную группу продукции.
          </p>
        </div>
        <a class="vl21-btn" href="{{ VL_CATALOG_URL }}">Открыть полный каталог</a>
      </div>

      <div class="vl21-catalog-grid">
        <a class="vl21-catalog-card" href="/collection/derevyannye-opory">
          <span class="vl21-catalog-num">01</span>
          <div>
            <h3>Деревянные опоры</h3>
            <p>Массив дерева, стандартные модели и решения для мебельного производства.</p>
            <div class="vl21-catalog-arrow">→</div>
          </div>
        </a>

        <a class="vl21-catalog-card" href="/collection/metallicheskie-opory">
          <span class="vl21-catalog-num">02</span>
          <div>
            <h3>Металлические опоры</h3>
            <p>Металл, разные покрытия, размеры и конструкции под задачи фабрики.</p>
            <div class="vl21-catalog-arrow">→</div>
          </div>
        </a>

        <a class="vl21-catalog-card" href="/collection/mebelnaya-furnitura">
          <span class="vl21-catalog-num">03</span>
          <div>
            <h3>Мебельная фурнитура</h3>
            <p>Комплектующие и сопутствующая продукция для мебельных проектов.</p>
            <div class="vl21-catalog-arrow">→</div>
          </div>
        </a>

        <a class="vl21-catalog-card" href="/collection/proizvodstvo-na-zakaz">
          <span class="vl21-catalog-num">04</span>
          <div>
            <h3>Производство под заказ</h3>
            <p>Изготовление по чертежу, образцу или техническому заданию.</p>
            <div class="vl21-catalog-arrow">→</div>
          </div>
        </a>

        <a class="vl21-catalog-card" href="/collections">
          <span class="vl21-catalog-num">05</span>
          <div>
            <h3>Все категории</h3>
            <p>Полный перечень направлений и товарных групп тестового магазина.</p>
            <div class="vl21-catalog-arrow">→</div>
          </div>
        </a>

        <a class="vl21-catalog-card" href="{{ VL_CATALOG_URL }}">
          <span class="vl21-catalog-num">06</span>
          <div>
            <h3>Смотреть каталог</h3>
            <p>Одна точка входа для клиента, который ещё не знает нужную категорию.</p>
            <div class="vl21-catalog-arrow">→</div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- =====================================================
       V2.1 VELES LIGHT
       ===================================================== -->
  <section class="vl21-section" id="vl21-light">
    <div class="vl21-wrap">
      <div class="vl21-light">
        <div class="vl21-light-copy">
          <div class="vl21-kicker">02 / Новое производство</div>
          <h2 class="vl21-title">Veles Light</h2>
          <p class="vl21-copy">
            Новое направление собственного производства — настольные лампы.
            Отдельная продуктовая линия, которую мы развиваем параллельно с мебельной продукцией.
          </p>
          <div class="vl21-actions">
            <a class="vl21-btn vl21-btn--light" href="/collection/veles-light">Смотреть Veles Light</a>
            <a class="vl21-btn" href="/contact">Обсудить производство</a>
          </div>
        </div>
        <div class="vl21-light-visual" aria-hidden="true">
          <div class="vl21-lamp-orbit">
            <div class="vl21-lamp-core"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================
       V2.1 FINAL CTA
       ===================================================== -->
  <section class="vl21-section vl21-section--soft" id="vl21-final-cta">
    <div class="vl21-wrap">
      <div class="vl21-kicker">03 / Следующий шаг</div>
      <h2 class="vl21-title">Подберём решение под ваш проект</h2>
      <p class="vl21-copy">
        Готовые модели, оптовые партии и производство по техническому заданию.
      </p>
      <div class="vl21-actions">
        <a class="vl21-btn" href="{{ VL_CATALOG_URL }}">Перейти в каталог</a>
        <a class="vl21-btn vl21-btn--light" href="/contact">Связаться с нами</a>
      </div>
    </div>
  </section>
</div>

<script>
(function () {
  'use strict';

  var catalogUrl = {{ VL_CATALOG_URL | json }};

  function upgradeHero() {
    var hero = document.querySelector('.vl-v2-hero');
    if (!hero) return;

    var title = hero.querySelector('h1');
    if (title) {
      title.innerHTML = 'МЕБЕЛЬНЫЕ ОПОРЫ<br>ДЛЯ ФАБРИК <span>СОБСТВЕННОЕ ПРОИЗВОДСТВО · B2B · РОССИЯ</span>';
    }

    var description = hero.querySelector('.vl-v2-hero-description');
    if (description) {
      description.textContent = 'Деревянные и металлические опоры собственного производства. Готовые решения, оптовые партии и изготовление по вашему техническому заданию.';
    }

    var buttons = hero.querySelectorAll('.vl-v2-btn');
    if (buttons.length) {
      buttons[0].textContent = 'Смотреть каталог';
      buttons[0].setAttribute('href', catalogUrl);
    }
    if (buttons.length > 1) {
      buttons[1].textContent = 'Получить прайс';
      buttons[1].setAttribute('href', '/contact');
    }
  }

  function wireCatalogLinks() {
    document.querySelectorAll('.vl21-layer a[href="/page/catalog"]').forEach(function (link) {
      link.setAttribute('href', catalogUrl);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      upgradeHero();
      wireCatalogLinks();
    });
  } else {
    upgradeHero();
    wireCatalogLinks();
  }
})();
</script>

<script>
(function () {
  'use strict';

  function arrangeV21Dom() {
    var root = document.querySelector('.vl-v2');
    var layer = document.getElementById('vl21-layer');
    if (!root || !layer) return false;

    var calculator = document.getElementById('vl-v2-calculator');
    var oldCustom = document.getElementById('vl-v2-custom');
    var oldClients = root.querySelector('.vl-v2-section:has(.vl-v2-client-grid)');
    var oldWhy = root.querySelector('.vl-v2-section:has(.vl-v2-why-grid)');
    var oldFinal = root.querySelector('.vl-v2-final');

    [oldCustom, oldClients, oldWhy, oldFinal].forEach(function (el) {
      if (el) el.style.display = 'none';
    });

    if (calculator) {
      root.insertBefore(layer, calculator);
      root.appendChild(calculator);
    } else {
      root.appendChild(layer);
    }

    return true;
  }

  if (arrangeV21Dom()) return;

  var observer = new MutationObserver(function () {
    if (arrangeV21Dom()) observer.disconnect();
  });

  observer.observe(document.documentElement, { childList: true, subtree: true });

  setTimeout(function () {
    observer.disconnect();
    arrangeV21Dom();
  }, 5000);
})();
</script>

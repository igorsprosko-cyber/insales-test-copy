<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Montserrat:wght@300;400;500;600;700&family=Roboto:wght@400;500;700&display=swap');

  :root {
    --vl-black: #0a0a0a;
    --vl-white: #ffffff;
    --vl-green: #2f9e44;
    --vl-soft: #f5f5f2;
    --vl-line: #d8d8d4;
    --vl-max: 1240px;
  }

  .vl-v2,
  .vl-v2 * { box-sizing: border-box; }

  .vl-v2 { width: 100%; background: var(--vl-white); color: var(--vl-black); font-family: Arial, Helvetica, sans-serif; }
  .vl-v2 a { color: inherit; }
  .vl-v2 button,
  .vl-v2 input,
  .vl-v2 select,
  .vl-v2 textarea { font: inherit; }
  .vl-v2 img { max-width: 100%; height: auto; }

  .vl-v2-wrap { width: min(calc(100% - 40px), var(--vl-max)); margin: 0 auto; }
  .vl-v2-section { padding: 88px 0; }
  .vl-v2-soft { background: var(--vl-soft); border-top: 1px solid var(--vl-line); border-bottom: 1px solid var(--vl-line); }
  .vl-v2-kicker { margin-bottom: 14px; font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; }
  .vl-v2-title { margin: 0; max-width: 820px; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(38px, 6vw, 70px); line-height: .98; letter-spacing: -1.5px; }
  .vl-v2-copy { max-width: 680px; margin: 20px 0 0; color: #444; font-size: 17px; line-height: 1.7; }
  .vl-v2-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .vl-v2-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0 25px; border: 1px solid #000; background: #000; color: #fff !important; text-decoration: none !important; font-size: 11px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; transition: .2s ease; }
  .vl-v2-btn:hover { background: var(--vl-green); border-color: var(--vl-green); color: #fff !important; transform: translateY(-2px); }
  .vl-v2-btn-light { background: #fff; color: #000 !important; }
  .vl-v2-btn-light:hover { background: var(--vl-green); border-color: var(--vl-green); color: #fff !important; }

  .vl-v2-catalog-head { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 42px; }
  .vl-v2-catalog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .vl-v2-catalog-card { min-height: 250px; display: flex; flex-direction: column; justify-content: space-between; padding: 28px; border: 1px solid #000; background: #fff; color: #000; text-decoration: none !important; transition: .25s ease; }
  .vl-v2-catalog-card:hover { background: #000; color: #fff; transform: translateY(-4px); }
  .vl-v2-catalog-num { font-family: Georgia, serif; font-size: 30px; color: #aaa; }
  .vl-v2-catalog-card h3 { margin: 0 0 8px; font-family: Georgia, serif; font-size: 27px; }
  .vl-v2-catalog-card p { margin: 0; color: #555; font-size: 13px; line-height: 1.5; }
  .vl-v2-catalog-card:hover p { color: #ccc; }
  .vl-v2-catalog-arrow { margin-top: 20px; font-size: 20px; }
  .vl-v2-catalog-main { display: block; margin-top: 18px; padding: 22px 25px; border: 1px solid #000; background: #000; color: #fff !important; text-decoration: none !important; transition: .2s ease; }
  .vl-v2-catalog-main:hover { background: var(--vl-green); border-color: var(--vl-green); transform: translateY(-2px); }
  .vl-v2-catalog-main strong { display: block; margin-bottom: 7px; font-size: 13px; letter-spacing: 1px; text-transform: uppercase; }
  .vl-v2-catalog-main span { display: block; color: #ccc; font-size: 14px; }

  .vl-v2-light { display: grid; grid-template-columns: 1.1fr .9fr; min-height: 420px; border: 1px solid #000; background: #000; color: #fff; }
  .vl-v2-light-copy { padding: 55px; }
  .vl-v2-light-copy .vl-v2-kicker { color: #aaa; }
  .vl-v2-light-copy .vl-v2-title { color: #fff; }
  .vl-v2-light-copy .vl-v2-copy { color: #c7c7c7; }
  .vl-v2-light-visual { min-height: 360px; display: flex; align-items: center; justify-content: center; background: #111; }
  .vl-v2-lamp-orbit { width: 230px; height: 230px; position: relative; border: 1px solid rgba(255,255,255,.35); }
  .vl-v2-lamp-orbit:before,.vl-v2-lamp-orbit:after { content:''; position:absolute; left:50%; top:0; width:1px; height:100%; background:rgba(255,255,255,.16); transform:translateX(-50%); }
  .vl-v2-lamp-orbit:after { transform:translateX(-50%) rotate(90deg); }
  .vl-v2-lamp { position:absolute; left:50%; top:50%; width:70px; height:110px; transform:translate(-50%,-50%); background:#eee; box-shadow:0 0 55px rgba(255,255,255,.65); }

  @media (max-width: 900px) {
    .vl-v2-catalog-grid { grid-template-columns: repeat(2, 1fr); }
    .vl-v2-light { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .vl-v2-wrap { width: min(calc(100% - 28px), var(--vl-max)); }
    .vl-v2-section { padding: 62px 0; }
    .vl-v2-catalog-head { align-items: start; flex-direction: column; }
    .vl-v2-catalog-grid { grid-template-columns: 1fr; }
    .vl-v2-light-copy { padding: 35px 25px; }
  }
</style>

<div class="vl-v2">
  <!-- Existing test-site homepage content begins here. Calculator and its JS remain intact below. -->
  {{ content_for_layout }}
</div>


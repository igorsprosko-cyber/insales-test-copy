{% comment %}
  VELES LEGS — HOMEPAGE V2
  Тестовая версия.
  Основной сайт НЕ затрагивается.

  Структура:
  1. Hero / B2B позиционирование
  2. Ключевые преимущества
  3. Категории продукции
  4. B2B калькулятор
  5. Производство по чертежу
  6. Для кого работаем
  7. Почему Veles Legs
  8. Финальный CTA

  Калькулятор сохранён из текущей версии.
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Montserrat:wght@300;400;500;600;700&family=Roboto:wght@400;500;700&display=swap');

  :root {
    --vl-black: #0a0a0a;
    --vl-white: #fff;
    --vl-gray-50: #f7f7f5;
    --vl-gray-100: #ededeb;
    --vl-gray-300: #cfcfcb;
    --vl-gray-500: #777;
    --vl-max: 1240px;
    --vl-radius: 14px;
  }

  .vl-v2,
  .vl-v2 * {
    box-sizing: border-box;
  }

  .vl-v2 {
    width: 100%;
    background: #fff;
    color: var(--vl-black);
    font-family: 'Roboto', Arial, sans-serif;
  }

  .vl-v2 a {
    color: inherit;
  }

  .vl-v2-container {
    width: min(100% - 40px, var(--vl-max));
    margin: 0 auto;
  }

  .vl-v2-section {
    padding: 90px 0;
  }

  .vl-v2-section--gray {
    background: var(--vl-gray-50);
  }

  .vl-v2-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    font-family: 'Montserrat', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
  }

  .vl-v2-eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: #000;
  }

  .vl-v2-title {
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.02;
    letter-spacing: -.7px;
  }

  .vl-v2-title--small {
    font-size: clamp(30px, 4vw, 44px);
  }

  .vl-v2-text {
    color: #444;
    font-size: 16px;
    line-height: 1.7;
  }

  /* =========================================================
     HERO
  ========================================================= */

  .vl-v2-hero {
    position: relative;
    overflow: hidden;
    min-height: 680px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #000;
    background:
      radial-gradient(circle at 85% 25%, #f2f2ef 0, transparent 32%),
      #fff;
  }

  .vl-v2-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr);
    gap: 70px;
    align-items: center;
  }

  .vl-v2-hero h1 {
    margin: 0;
    max-width: 760px;
    font-family: 'Playfair Display', serif;
    font-size: clamp(54px, 8vw, 104px) !important;
    line-height: .9 !important;
    letter-spacing: -3px;
    text-transform: uppercase;
  }

  .vl-v2-hero h1 span {
    display: block;
    margin-top: 24px;
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(13px, 2vw, 18px);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 4px;
    color: #555;
  }

  .vl-v2-hero-description {
    max-width: 650px;
    margin: 30px 0;
    font-family: 'Montserrat', sans-serif;
    font-size: 18px;
    font-weight: 300;
    line-height: 1.65;
    color: #333;
  }

  .vl-v2-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .vl-v2-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 28px;
    border: 1px solid #000;
    border-radius: 3px;
    background: #000;
    color: #fff !important;
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-decoration: none !important;
    text-transform: uppercase;
    cursor: pointer;
    transition: .25s ease;
  }

  .vl-v2-btn:hover {
    background: #fff;
    color: #000 !important;
    transform: translateY(-2px);
  }

  .vl-v2-btn--outline {
    background: transparent;
    color: #000 !important;
  }

  .vl-v2-btn--outline:hover {
    background: #000;
    color: #fff !important;
  }

  .vl-v2-hero-card {
    position: relative;
    padding: 0;
    overflow: hidden;
    display: flex;
    align-items: stretch;
    justify-content: center;
    background: #f7f7f5;
    border: 1px solid #000;
    box-shadow: 16px 16px 0 #000;
  }

  .vl-v2-hero-card-photo {
    display: block;
    width: 100%;
    height: 560px;
    min-height: 0;
    margin: 0;
    border: 0;
    object-fit: cover;
    object-position: center center;
    background: #f7f7f5;
  }

  .vl-v2-hero-card strong {
    display: block;
    margin-bottom: 10px;
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    letter-spacing: .5px;
  }

  .vl-v2-hero-card p {
    margin: 0;
    color: #555;
    font-size: 14px;
    line-height: 1.6;
  }

  .vl-v2-hero-meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 650px;
    margin-top: 50px;
    border-top: 1px solid #000;
    border-bottom: 1px solid #000;
  }

  .vl-v2-hero-meta-item {
    padding: 18px 12px;
    border-right: 1px solid #000;
  }

  .vl-v2-hero-meta-item:last-child {
    border-right: 0;
  }

  .vl-v2-hero-meta-item strong {
    display: block;
    font-family: 'Playfair Display', serif;
    font-size: 25px;
  }

  .vl-v2-hero-meta-item span {
    display: block;
    margin-top: 4px;
    color: #666;
    font-family: 'Montserrat', sans-serif;
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* =========================================================
     TRUST STRIP
  ========================================================= */

  .vl-v2-trust {
    border-bottom: 1px solid #ddd;
  }

  .vl-v2-trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .vl-v2-trust-item {
    min-height: 120px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 20px 25px;
    border-right: 1px solid #ddd;
  }

  .vl-v2-trust-item:last-child {
    border-right: 0;
  }

  .vl-v2-trust-item strong {
    margin-bottom: 7px;
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
  }

  .vl-v2-trust-item span {
    color: #666;
    font-size: 13px;
    line-height: 1.4;
  }

  /* =========================================================
     CATEGORIES
  ========================================================= */

  .vl-v2-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 30px;
    margin-bottom: 45px;
  }

  .vl-v2-heading-copy {
    max-width: 700px;
  }

  .vl-v2-heading-copy p {
    max-width: 650px;
    margin: 18px 0 0;
  }

  .vl-v2-category-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .vl-v2-category {
    position: relative;
    min-height: 270px;
    display: flex;
    flex-direction: column;
    justify-content: end;
    padding: 30px;
    overflow: hidden;
    background: #fff;
    border: 1px solid #000;
    text-decoration: none !important;
    transition: .3s ease;
  }

  .vl-v2-category::before {
    content: attr(data-number);
    position: absolute;
    top: 18px;
    right: 22px;
    font-family: 'Playfair Display', serif;
    font-size: 34px;
    color: #ddd;
  }

  .vl-v2-category-icon {
    position: absolute;
    top: 55px;
    left: 30px;
    font-size: 60px;
    filter: grayscale(1);
  }

  .vl-v2-category h3 {
    position: relative;
    z-index: 1;
    margin: 0 0 8px;
    font-family: 'Playfair Display', serif;
    font-size: 27px;
  }

  .vl-v2-category p {
    position: relative;
    z-index: 1;
    margin: 0;
    color: #555;
    font-size: 13px;
    line-height: 1.5;
  }

  .vl-v2-category:hover {
    background: #000;
    color: #fff;
    transform: translateY(-5px);
  }

  .vl-v2-category:hover p {
    color: #ccc;
  }

  /* =========================================================
     B2B CALCULATOR INTRO
  ========================================================= */

  .vl-v2-calculator-intro {
    display: grid;
    grid-template-columns: .7fr 1.3fr;
    gap: 60px;
    align-items: start;
    margin-bottom: 45px;
  }

  .vl-v2-calculator-note {
    padding: 25px;
    background: #fff;
    border: 1px solid #000;
  }

  .vl-v2-calculator-note strong {
    display: block;
    margin-bottom: 8px;
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .vl-v2-calculator-note p {
    margin: 0;
    color: #555;
    font-size: 13px;
    line-height: 1.6;
  }

  /* =========================================================
     ORIGINAL CALCULATOR
  ========================================================= */

  .vl-selector {
    padding: 0;
    background: transparent;
    font-family: 'Roboto', Arial, sans-serif;
    text-align: center;
  }

  .vl-selector h2,
  .vl-selector .subtitle {
    display: none;
  }

  .vl-selector-tabs {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 25px;
  }

  .vl-tab {
    background: transparent;
    border: 1px solid #000;
    color: #000;
    padding: 11px 25px;
    border-radius: 30px;
    font-size: 13px;
    cursor: pointer;
    transition: .2s;
    font-family: 'Montserrat', sans-serif;
    font-weight: 500;
  }

  .vl-tab.active {
    background: #000;
    color: #fff;
  }

  .vl-tab:not(.active):hover {
    background: #f0f0f0;
  }

  .vl-selector-panel {
    display: none;
    max-width: 1000px;
    margin: 0 auto;
  }

  .vl-selector-panel.active {
    display: block;
  }

  .vl-columns {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .vl-column {
    flex: 1 1 500px;
    min-width: 300px;
    background: #fff;
    padding: 25px;
    border: 1px solid #000;
    border-radius: var(--vl-radius);
    text-align: left;
  }

  .vl-column h3 {
    font-family: 'Playfair Display', serif;
    font-size: 23px;
    margin: 0 0 20px;
    text-align: center;
    color: #000;
  }

  .vl-select-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 10px;
  }

  .vl-select-group label {
    font-weight: 500;
    font-size: 13px;
    margin-bottom: 5px;
    color: #000;
  }

  .vl-select-group select,
  .vl-select-group input,
  .vl-select-group textarea {
    width: 100%;
    padding: 10px 13px;
    border: 1px solid #000;
    border-radius: 8px;
    font-size: 14px;
    background: #fff;
    outline: none;
    color: #000;
    font-family: 'Roboto', sans-serif;
  }

  .vl-select-group textarea {
    border-radius: 8px;
    resize: vertical;
    min-height: 70px;
  }

  .vl-select-group .hint-text {
    font-size: 11px;
    color: #666;
    margin-top: 4px;
    font-style: italic;
  }

  .vl-calc-result {
    background: #f8f8f6;
    border: 1px solid #000;
    border-radius: 10px;
    padding: 15px;
    margin-top: 18px;
    display: none;
  }

  .vl-calc-row {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    font-size: 13px;
    margin-bottom: 7px;
    color: #333;
  }

  .vl-calc-row.total {
    border-top: 1px solid #000;
    padding-top: 7px;
    margin-top: 7px;
    font-weight: 700;
    font-size: 16px;
    color: #000;
  }

  .vl-calc-row.vat-row {
    font-size: 12px;
    color: #555;
    margin-bottom: 4px;
  }

  .vl-calc-row.total-vat {
    border-top: 2px solid #000;
    padding-top: 10px;
    margin-top: 10px;
    font-weight: 900;
    font-size: 20px;
    color: #000;
  }

  .vl-calc-discount {
    color: #d32f2f;
    font-weight: 600;
  }

  .vl-action {
    margin-top: 25px;
    text-align: center;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
  }

  .vl-action .btn-final {
    display: inline-block;
    padding: 16px 30px;
    background: #000;
    color: #fff;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    text-decoration: none;
    border-radius: 3px;
    border: 2px solid #000;
    cursor: pointer;
    transition: .3s ease;
  }

  .vl-action .btn-final:hover {
    background: #fff;
    color: #000;
    transform: translateY(-2px);
  }

  .vl-form-block {
    display: none;
    margin-top: 25px;
    background: #f9f9f9;
    padding: 25px;
    border-radius: 12px;
    border: 1px solid #000;
    text-align: left;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .vl-form-block h4 {
    font-family: 'Playfair Display', serif;
    margin: 0 0 15px;
    text-align: center;
    font-size: 22px;
  }

  .vl-form-block input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #000;
    border-radius: 8px;
    font-size: 14px;
    margin-bottom: 12px;
    background: #fff;
  }

  .vl-form-block textarea {
    width: 100%;
    padding: 16px 18px;
    border: 1px solid #000;
    border-radius: 10px;
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 15px;
    min-height: 280px;
    resize: vertical;
    font-family: 'Roboto', Arial, sans-serif;
  }

  .vl-form-block .send-btn {
    display: block;
    width: 100%;
    padding: 14px;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    font-family: 'Montserrat', sans-serif;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* =========================================================
     CUSTOM PRODUCTION
  ========================================================= */

  .vl-v2-custom {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 60px;
    align-items: center;
  }

  .vl-v2-custom-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: 30px;
  }

  .vl-v2-custom-item {
    padding: 20px;
    border: 1px solid #000;
    background: #fff;
  }

  .vl-v2-custom-item strong {
    display: block;
    margin-bottom: 7px;
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
  }

  .vl-v2-custom-item span {
    color: #666;
    font-size: 12px;
    line-height: 1.5;
  }

  .vl-v2-blueprint {
    height: 380px;
    max-width: 340px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #fafaf8;
    border: 1px solid #000;
  }

  .vl-v2-blueprint-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    background: #fafaf8;
  }

  /* =========================================================
     CLIENTS
  ========================================================= */

  .vl-v2-client-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .vl-v2-client {
    min-height: 120px;
    padding: 16px;
    border: 1px solid #000;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .vl-v2-client-icon {
    font-size: 38px;
    filter: grayscale(1);
  }

  .vl-v2-client strong {
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    line-height: 1.4;
  }

  /* =========================================================
     WHY US
  ========================================================= */

  .vl-v2-why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid #000;
    border-bottom: 1px solid #000;
  }

  .vl-v2-why {
    padding: 20px;
    border-right: 1px solid #000;
  }

  .vl-v2-why:last-child {
    border-right: 0;
  }

  .vl-v2-why-number {
    font-family: 'Playfair Display', serif;
    font-size: 48px;
    color: #bbb;
  }

  .vl-v2-why h3 {
    margin: 20px 0 10px;
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
  }

  .vl-v2-why p {
    margin: 0;
    color: #555;
    font-size: 13px;
    line-height: 1.6;
  }

  /* =========================================================
     FINAL CTA
  ========================================================= */

  .vl-v2-final {
    padding: 110px 20px;
    background: #000;
    color: #fff;
    text-align: center;
  }

  .vl-v2-final .vl-v2-eyebrow {
    color: #fff;
  }

  .vl-v2-final .vl-v2-eyebrow::before {
    background: #fff;
  }

  .vl-v2-final h2 {
    max-width: 850px;
    margin: 0 auto 25px;
    font-family: 'Playfair Display', serif;
    font-size: clamp(42px, 6vw, 72px);
    line-height: 1;
  }

  .vl-v2-final p {
    max-width: 600px;
    margin: 0 auto 35px;
    color: #ccc;
    font-size: 16px;
    line-height: 1.7;
  }

  .vl-v2-final .vl-v2-btn {
    background: #fff;
    color: #000 !important;
    border-color: #fff;
  }

  .vl-v2-final .vl-v2-btn:hover {
    background: transparent;
    color: #fff !important;
  }

  .vl-v2-final-contacts {
    margin-top: 35px;
    color: #aaa;
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
  }

  .vl-v2-final-contacts a {
    color: #fff;
  }

  /* =========================================================
     RESPONSIVE
  ========================================================= */

  @media (max-width: 900px) {
    .vl-v2-hero-grid,
    .vl-v2-custom,
    .vl-v2-calculator-intro {
      grid-template-columns: 1fr;
    }

    .vl-v2-hero {
      min-height: auto;
      padding: 80px 0;
    }

    .vl-v2-hero-card {
      max-width: 500px;
    }

    .vl-v2-hero-card-photo {
      height: 520px;
    }

    .vl-v2-trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .vl-v2-trust-item:nth-child(2) {
      border-right: 0;
    }

    .vl-v2-trust-item:nth-child(-n+2) {
      border-bottom: 1px solid #ddd;
    }

    .vl-v2-category-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .vl-v2-client-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .vl-v2-why-grid {
      grid-template-columns: 1fr;
    }

    .vl-v2-why {
      border-right: 0;
      border-bottom: 1px solid #000;
    }

    .vl-v2-why:last-child {
      border-bottom: 0;
    }
  }

  @media (max-width: 600px) {
    .vl-v2-container {
      width: min(100% - 28px, var(--vl-max));
    }

    .vl-v2-section {
      padding: 65px 0;
    }

    .vl-v2-hero h1 {
      letter-spacing: -2px;
    }

    .vl-v2-hero-card {
      box-shadow: 8px 8px 0 #000;
    }

    .vl-v2-hero-card-photo {
      height: 440px;
    }

    .vl-v2-hero-meta {
      grid-template-columns: 1fr;
    }

    .vl-v2-hero-meta-item {
      border-right: 0;
      border-bottom: 1px solid #000;
    }

    .vl-v2-hero-meta-item:last-child {
      border-bottom: 0;
    }

    .vl-v2-heading {
      display: block;
    }

    .vl-v2-category-grid,
    .vl-v2-client-grid,
    .vl-v2-custom-list {
      grid-template-columns: 1fr;
    }

    .vl-v2-blueprint {
      height: 260px;
    }

    .vl-v2-actions {
      flex-direction: column;
    }

    .vl-v2-btn {
      width: 100%;
    }
  }

  /* =========================================================
     VELES LIGHT
  ========================================================= */
  .vl-light {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    min-height: 420px;
    border: 1px solid #000;
    background: #000;
    color: #fff;
  }

  .vl-light-copy {
    padding: 55px;
  }

  .vl-light-copy .vl-v2-eyebrow {
    color: #aaa;
  }

  .vl-light-copy .vl-v2-title {
    color: #fff;
  }


<script>
(function () {

  /*
   * ==========================================================
   * TABS
   * ==========================================================
   */

  document.querySelectorAll('.vl-v2 .vl-tab').forEach(function (tab) {

    tab.addEventListener('click', function () {

      document.querySelectorAll('.vl-v2 .vl-tab')
        .forEach(function (item) {
          item.classList.remove('active');
        });

      document.querySelectorAll('.vl-v2 .vl-selector-panel')
        .forEach(function (panel) {
          panel.classList.remove('active');
        });

      tab.classList.add('active');

      var target =
        document.getElementById(
          'panel-' + tab.getAttribute('data-tab')
        );

      if (target) {
        target.classList.add('active');
      }

    });

  });


  /*
   * ==========================================================
   * TRANSLATIONS
   * ==========================================================
   */

  var translations = {

    shape: {
      round: 'Круглые',
      square: 'Квадратные',
      carved: 'Резные (фигурные)'
    },

    form: {
      straight: 'Прямые',
      cone: 'Конусные'
    },

    color: {
      unpainted: 'Без покраски',
      lacquer: 'Лак',
      black: 'Черные',
      wenge: 'Венге',
      ral: 'RAL (под заказ)'
    },

    mount: {
      none: 'Без крепления',
      stud_m8: 'Шпилька М8',
      screw_m6: 'Винт М6',
      screw_m10: 'Винт М10',
      plate: 'Площадка',
      plate_screw_m8: 'Площадка с винтом М8'
    },

    base: {
      without_wheel: 'Без колеса (войлок/торец)',
      with_wheel: 'С колесом'
    },

    tilt: {
      no: 'Нет (прямая)',
      '15': '15°',
      '30': '30°',
      '45': '45°'
    }

  };


  /*
   * ==========================================================
   * HEIGHT
   * ==========================================================
   */

  window.handleWoodHeight = function (sel) {

    var group = sel.closest('.vl-select-group');

    if (!group) return;

    var otherInput =
      group.querySelector('.wood-height-other');

    if (!otherInput) return;

    otherInput.style.display =
      sel.value === 'other'
        ? 'block'
        : 'none';

    if (sel.value !== 'other') {
      otherInput.value = '';
    }

  };


  /*
   * ==========================================================
   * SHAPE
   * ==========================================================
   */

  window.handleWoodShape = function (sel) {

    var col = sel.closest('.vl-column');

    if (!col) return;

    var formGroup =
      col.querySelector('.wood-form-group');

    var dimGroup =
      col.querySelector('.wood-dim-group');

    var bottomDimGroup =
      col.querySelector('.wood-bottom-dim-group');

    var carvedDesc =
      col.querySelector('.wood-carved-desc');

    var roundLabel =
      col.querySelector('.dim-label-round');

    var squareLabel =
      col.querySelector('.dim-label-square');

    var roundLabelBottom =
      col.querySelector('.dim-label-round-bottom');

    var squareLabelBottom =
      col.querySelector('.dim-label-square-bottom');

    var roundSelect =
      col.querySelector('.wood-top-diameter');

    var squareSelect =
      col.querySelector('.wood-top-size');

    var roundSelectBottom =
      col.querySelector('.wood-bottom-diameter');

    var squareSelectBottom =
      col.querySelector('.wood-bottom-size');

    var form =
      col.querySelector('.wood-form');

    var formVal =
      form ? form.value : 'straight';


    if (sel.value === 'round') {

      formGroup.style.display = 'flex';
      dimGroup.style.display = 'flex';
      carvedDesc.style.display = 'none';

      roundLabel.style.display = 'block';
      squareLabel.style.display = 'none';

      roundLabelBottom.style.display = 'block';
      squareLabelBottom.style.display = 'none';

      roundSelect.style.display = 'block';
      squareSelect.style.display = 'none';

      roundSelectBottom.style.display = 'block';
      squareSelectBottom.style.display = 'none';

      bottomDimGroup.style.display =
        formVal === 'cone'
          ? 'flex'
          : 'none';

    }

    else if (sel.value === 'square') {

      formGroup.style.display = 'flex';
      dimGroup.style.display = 'flex';
      carvedDesc.style.display = 'none';

      roundLabel.style.display = 'none';
      squareLabel.style.display = 'block';

      roundLabelBottom.style.display = 'none';
      squareLabelBottom.style.display = 'block';

      roundSelect.style.display = 'none';
      squareSelect.style.display = 'block';

      roundSelectBottom.style.display = 'none';
      squareSelectBottom.style.display = 'block';

      bottomDimGroup.style.display =
        formVal === 'cone'
          ? 'flex'
          : 'none';

    }

    else if (sel.value === 'carved') {

      formGroup.style.display = 'flex';
      dimGroup.style.display = 'flex';
      bottomDimGroup.style.display = 'flex';
      carvedDesc.style.display = 'flex';

      roundLabel.style.display = 'block';
      squareLabel.style.display = 'none';

      roundLabelBottom.style.display = 'block';
      squareLabelBottom.style.display = 'none';

      roundSelect.style.display = 'block';
      squareSelect.style.display = 'none';

      roundSelectBottom.style.display = 'block';
      squareSelectBottom.style.display = 'none';

    }

    else {

      formGroup.style.display = 'none';
      dimGroup.style.display = 'none';
      bottomDimGroup.style.display = 'none';
      carvedDesc.style.display = 'none';

    }

  };


  /*
   * ==========================================================
   * FORM
   * ==========================================================
   */

  window.handleWoodForm = function (sel) {

    var col = sel.closest('.vl-column');

    if (!col) return;

    var bottomDimGroup =
      col.querySelector('.wood-bottom-dim-group');

    var shape =
      col.querySelector('.wood-shape').value;

    if (shape === 'carved') {

      bottomDimGroup.style.display = 'flex';

    } else if (
      sel.value === 'cone' &&
      (shape === 'round' || shape === 'square')
    ) {

      bottomDimGroup.style.display = 'flex';

    } else {

      bottomDimGroup.style.display = 'none';

    }

  };


  /*
   * ==========================================================
   * DIMENSIONS
   * ==========================================================
   */

  window.handleWoodDim = function (sel) {

    var group =
      sel.closest('.vl-select-group');

    if (!group) return;

    var otherInput =
      group.querySelector(
        '.wood-dim-other, .wood-bottom-dim-other'
      );

    if (!otherInput) return;

    otherInput.style.display =
      sel.value === 'other'
        ? 'block'
        : 'none';

    if (sel.value !== 'other') {
      otherInput.value = '';
    }

  };


  /*
   * ==========================================================
   * TILT
   * ==========================================================
   */

  window.handleWoodTilt = function (sel) {

    var group =
      sel.closest('.vl-select-group');

    var otherInput =
      group.querySelector('.wood-tilt-other');

    if (!otherInput) return;

    otherInput.style.display =
      sel.value === 'other'
        ? 'block'
        : 'none';

    if (sel.value !== 'other') {
      otherInput.value = '';
    }

  };


  /*
   * ==========================================================
   * BASE
   * ==========================================================
   */

  window.handleWoodBase = function (sel) {

    var group =
      sel.closest('.vl-select-group');

    var otherInput =
      group.querySelector('.wood-base-other');

    if (!otherInput) return;

    otherInput.style.display =
      sel.value === 'other'
        ? 'block'
        : 'none';

    if (sel.value !== 'other') {
      otherInput.value = '';
    }

  };


  /*
   * ==========================================================
   * COLOR
   * ==========================================================
   */

  window.handleWoodColor = function (sel) {

    var group =
      sel.closest('.vl-select-group');

    var otherInput =
      group.querySelector('.wood-color-other');

    if (!otherInput) return;

    otherInput.style.display =
      sel.value === 'ral'
        ? 'block'
        : 'none';

    if (sel.value !== 'ral') {
      otherInput.value = '';
    }

  };


  /*
   * ==========================================================
   * MAIN CALCULATOR
   * ==========================================================
   */

  window.calcWood = function (colIdx) {

    var hVal =
      document.getElementById(
        'wood-h-' + colIdx
      ).value;

    var shape =
      document.getElementById(
        'wood-shape-' + colIdx
      ).value;

    var form =
      document.getElementById(
        'wood-form-' + colIdx
      ).value;

    var dimSelect =
      shape === 'round' || shape === 'carved'
        ? document.getElementById(
            'wood-top-d-' + colIdx
          )
        : document.getElementById(
            'wood-top-s-' + colIdx
          );

    var dimVal =
      dimSelect
        ? dimSelect.value
        : '';

    var bottomDimSelect =
      shape === 'round' || shape === 'carved'
        ? document.getElementById(
            'wood-bottom-d-' + colIdx
          )
        : document.getElementById(
            'wood-bottom-s-' + colIdx
          );

    var bottomDimVal =
      bottomDimSelect
        ? bottomDimSelect.value
        : '';

    var color =
      document.getElementById(
        'wood-color-' + colIdx
      ).value;

    var base =
      document.getElementById(
        'wood-base-' + colIdx
      ).value;

    var tilt =
      document.getElementById(
        'wood-tilt-' + colIdx
      ).value;

    var qty =
      parseInt(
        document.getElementById(
          'wood-qty-' + colIdx
        ).value
      ) || 0;

    var resultBox =
      document.getElementById(
        'wood-calc-' + colIdx
      );

    var submitBtn =
      document.getElementById(
        'wood-submit-final-btn'
      );


    if (!hVal || !shape || qty < 1) {

      resultBox.style.display = 'none';
      submitBtn.style.display = 'none';

      return;

    }


    var needsManager = false;

    if (hVal === 'other') needsManager = true;
    if (shape === 'carved') needsManager = true;
    if (dimVal === 'other') needsManager = true;
    if (bottomDimVal === 'other') needsManager = true;
    if (color === 'ral') needsManager = true;
    if (base === 'other') needsManager = true;
    if (tilt === 'other') needsManager = true;
    if (qty >= 2000) needsManager = true;


    if (needsManager) {

      resultBox.style.display = 'none';

      submitBtn.style.display = 'inline-block';

      submitBtn.innerText =
        'ОТПРАВИТЬ ЗАПРОС МЕНЕДЖЕРУ';

      return;

    }


    var basePricePerCm = 0;

    var dNum =
      parseInt(dimVal);

    var bottomDNum =
      parseInt(bottomDimVal);

    var effectiveD =
      dNum;


    if (
      form === 'cone' &&
      !isNaN(bottomDNum) &&
      bottomDNum > 0
    ) {

      effectiveD =
        Math.max(
          dNum,
          bottomDNum
        );

    }


    if (shape === 'round') {

      if (effectiveD === 40)
        basePricePerCm = 24;

      else if (effectiveD === 50)
        basePricePerCm = 32;

      else if (effectiveD === 60)
        basePricePerCm = 44;

    }

    else if (shape === 'square') {

      if (effectiveD === 40)
        basePricePerCm = 32;

      else if (effectiveD === 50)
        basePricePerCm = 40;

      else if (effectiveD === 60)
        basePricePerCm = 52;

    }


    var heightCm =
      parseInt(hVal) / 10;

    var basePrice =
      basePricePerCm * heightCm;


    var componentPrice = 0;

    var mount =
      document.getElementById(
        'wood-mount-' + colIdx
      ).value;


    if (mount === 'plate')
      componentPrice = 32.5;

    else if (mount === 'plate_screw_m8')
      componentPrice = 40;


    if (base === 'with_wheel')
      componentPrice += 65;


    var colorPrice = 0;

    if (color === 'lacquer')
      colorPrice = 50;

    else if (color === 'black')
      colorPrice = 100;

    else if (color === 'wenge')
      colorPrice = 150;


    var finalUnitPriceExact =
      basePrice +
      componentPrice +
      colorPrice;


    var discount = 0;

    if (qty >= 1000)
      discount = 0.10;

    else if (qty >= 400)
      discount = 0.05;

    else if (qty >= 40)
      discount = 0.03;


    var discountedUnitPrice =
      finalUnitPriceExact *
      (1 - discount);

    var totalPrice =
      discountedUnitPrice * qty;

    var totalDiscountSum =
      (finalUnitPriceExact -
       discountedUnitPrice) * qty;


    var priceWithoutVat =
      totalPrice / 1.22;

    var vatAmount =
      totalPrice -
      priceWithoutVat;


    var weightPerUnit = 0;

    var placesCount = 0;


    if (shape === 'round') {

      var radius =
        dNum / 2000;

      var heightM =
        parseInt(hVal) / 1000;

      var volume =
        Math.PI *
        radius *
        radius *
        heightM;

      weightPerUnit =
        volume * 720;

    }

    else if (shape === 'square') {

      var sideM =
        dNum / 1000;

      var heightM =
        parseInt(hVal) / 1000;

      var volume =
        sideM *
        sideM *
        heightM;

      weightPerUnit =
        volume * 720;

    }


    var heightNum =
      parseInt(hVal);

    var capacityPerBox = 0;


    if (heightNum === 100)
      capacityPerBox = 100;

    else if (
      heightNum >= 110 &&
      heightNum <= 150
    )
      capacityPerBox = 70;

    else if (heightNum === 160)
      capacityPerBox = 60;

    else if (heightNum === 170)
      capacityPerBox = 50;

    else if (heightNum === 180)
      capacityPerBox = 45;

    else if (heightNum === 190)
      capacityPerBox = 40;

    else if (heightNum === 200)
      capacityPerBox = 35;

    else if (heightNum === 220)
      capacityPerBox = 30;

    else if (heightNum === 250)
      capacityPerBox = 25;

    else if (heightNum === 280)
      capacityPerBox = 20;

    else if (heightNum === 300)
      capacityPerBox = 18;

    else if (heightNum === 320)
      capacityPerBox = 15;

    else if (heightNum === 350)
      capacityPerBox = 12;

    else
      capacityPerBox = 10;


    placesCount =
      Math.ceil(
        qty / capacityPerBox
      );


    var totalWeight =
      (weightPerUnit * qty) +
      (0.2 * placesCount) +
      (0.35 * placesCount);


    document.getElementById(
      'wood-base-price-1'
    ).innerText =
      finalUnitPriceExact.toLocaleString(
        'ru-RU'
      ) + ' ₽';


    document.getElementById(
      'wood-qty-display-1'
    ).innerText =
      qty + ' шт';


    document.getElementById(
      'wood-price-no-vat-1'
    ).innerText =
      Math.round(
        priceWithoutVat
      ).toLocaleString(
        'ru-RU'
      ) + ' ₽';


    document.getElementById(
      'wood-vat-amount-1'
    ).innerText =
      Math.round(
        vatAmount
      ).toLocaleString(
        'ru-RU'
      ) + ' ₽';


    document.getElementById(
      'wood-total-1'
    ).innerText =
      Math.round(
        totalPrice
      ).toLocaleString(
        'ru-RU'
      ) + ' ₽';


    document.getElementById(
      'wood-weight-1'
    ).innerText =
      totalWeight.toFixed(2) +
      ' кг';


    document.getElementById(
      'wood-places-1'
    ).innerText =
      placesCount +
      ' мест';


    var discRow =
      document.getElementById(
        'wood-disc-row-1'
      );

    var sumDiscRow =
      document.getElementById(
        'wood-sum-disc-row-1'
      );


    if (discount > 0) {

      document.getElementById(
        'wood-disc-price-1'
      ).innerText =
        discountedUnitPrice.toLocaleString(
          'ru-RU',
          {
            minimumFractionDigits: 1,
            maximumFractionDigits: 1
          }
        ) +
        ' ₽ (' +
        (discount * 100) +
        '%)';


      document.getElementById(
        'wood-sum-disc-1'
      ).innerText =
        '-' +
        Math.round(
          totalDiscountSum
        ).toLocaleString(
          'ru-RU'
        ) +
        ' ₽';


      discRow.style.display =
        'flex';

      sumDiscRow.style.display =
        'flex';

    }

    else {

      discRow.style.display =
        'none';

      sumDiscRow.style.display =
        'none';

    }


    resultBox.style.display =
      'block';

    submitBtn.style.display =
      'inline-block';

    submitBtn.innerText =
      'ОТПРАВИТЬ РАСЧЕТ МЕНЕДЖЕРУ';

  };


  /*
   * ==========================================================
   * MANAGER FORM
   * ==========================================================
   */

  window.openManagerForm = function (type) {

    fillComment();

    var block =
      document.getElementById(
        'wood-form-block'
      );

    block.style.display =
      'block';

    block.scrollIntoView({
      behavior: 'smooth',
      block: 'center'
    });

  };


  /*
   * ==========================================================
   * FORM COMMENT
   * ==========================================================
   */

  function fillComment() {

    var h =
      document.getElementById(
        'wood-h-1'
      ).value;

    var hOther =
      document.getElementById(
        'wood-h-other-1'
      ).value;

    var shape =
      document.getElementById(
        'wood-shape-1'
      ).value;

    var form =
      document.getElementById(
        'wood-form-1'
      ).value;

    var dim =
      document.getElementById(
        'wood-top-d-1'
      ).value;

    var dimOther =
      document.getElementById(
        'wood-dim-other-1'
      ).value;

    var bottomDim =
      document.getElementById(
        'wood-bottom-d-1'
      ).value;

    var bottomDimOther =
      document.getElementById(
        'wood-bottom-dim-other-1'
      ).value;

    var tilt =
      document.getElementById(
        'wood-tilt-1'
      ).value;

    var tiltOther =
      document.getElementById(
        'wood-tilt-other-1'
      ).value;

    var color =
      document.getElementById(
        'wood-color-1'
      ).value;

    var colorOther =
      document.getElementById(
        'wood-color-other-1'
      ).value;

    var mount =
      document.getElementById(
        'wood-mount-1'
      ).value;

    var base =
      document.getElementById(
        'wood-base-1'
      ).value;

    var baseOther =
      document.getElementById(
        'wood-base-other-1'
      ).value;

    var carved =
      document.getElementById(
        'wood-carved-text-1'
      ).value;

    var qty =
      document.getElementById(
        'wood-qty-1'
      ).value;


    var comment =
      'Параметры из калькулятора:\n';


    comment +=
      '- Высота: ' +
      (
        h === 'other'
          ? hOther + ' мм (под заказ)'
          : h + ' мм'
      ) +
      '\n';


    comment +=
      '- Сечение: ' +
      (
        translations.shape[shape] ||
        shape
      ) +
      '\n';


    if (shape !== 'carved') {

      comment +=
        '- Форма: ' +
        (
          translations.form[form] ||
          form
        ) +
        '\n';


      var dimText =
        dim === 'other'
          ? dimOther + ' мм (под заказ)'
          : dim + ' мм';


      comment +=
        '- Верхний размер: ' +
        dimText +
        '\n';


      if (form === 'cone') {

        var bottomDimText =
          bottomDim === 'other'
            ? bottomDimOther + ' мм (под заказ)'
            : bottomDim + ' мм';


        comment +=
          '- Нижний размер: ' +
          bottomDimText +
          '\n';

      }

    }

    else {

      comment +=
        '- Базовый диаметр: ' +
        (
          dim === 'other'
            ? dimOther + ' мм (под заказ)'
            : dim + ' мм'
        ) +
        '\n';


      var carvedBottom =
        bottomDim === 'other'
          ? bottomDimOther + ' мм (под заказ)'
          : bottomDim + ' мм';


      comment +=
        '- Нижний диаметр: ' +
        carvedBottom +
        '\n';


      if (carved) {

        comment +=
          '- Описание модели: ' +
          carved +
          '\n';

      }

    }


    var tiltText =
      tilt === 'other'
        ? tiltOther + '° (под заказ)'
        : (
            translations.tilt[tilt] ||
            tilt
          );


    comment +=
      '- Наклон: ' +
      tiltText +
      '\n';


    if (color === 'ral') {

      comment +=
        '- Цвет: RAL — ' +
        (
          colorOther ||
          'не указан'
        ) +
        '\n';

    }

    else {

      comment +=
        '- Цвет: ' +
        (
          translations.color[color] ||
          color
        ) +
        '\n';

    }


    comment +=
      '- Крепление: ' +
      (
        translations.mount[mount] ||
        mount
      ) +
      '\n';


    var baseText =
      base === 'other'
        ? baseOther + ' (под заказ)'
        : (
            translations.base[base] ||
            base
          );


    comment +=
      '- Основание: ' +
      baseText +
      '\n';


    comment +=
      '- Количество: ' +
      qty +
      ' шт.\n';


    var resultBox =
      document.getElementById(
        'wood-calc-1'
      );


    if (
      resultBox &&
      resultBox.style.display === 'block'
    ) {

      var total =
        document.getElementById(
          'wood-total-1'
        ).innerText;

      var priceNoVat =
        document.getElementById(
          'wood-price-no-vat-1'
        ).innerText;

      var vatAmount =
        document.getElementById(
          'wood-vat-amount-1'
        ).innerText;

      var weight =
        document.getElementById(
          'wood-weight-1'
        ).innerText;

      var places =
        document.getElementById(
          'wood-places-1'
        ).innerText;


      if (priceNoVat !== '0 ₽') {

        comment +=
          '- Цена без НДС: ' +
          priceNoVat +
          '\n';

      }


      if (vatAmount !== '0 ₽') {

        comment +=
          '- НДС 22%: ' +
          vatAmount +
          '\n';

      }


      if (total !== '0 ₽') {

        comment +=
          '- Итого с НДС: ' +
          total +
          '\n';

      }


      if (weight !== '0 кг') {

        comment +=
          '- Вес партии: ' +
          weight +
          '\n';

      }


      if (places !== '0 мест') {

        comment +=
          '- Количество мест: ' +
          places +
          '\n';

      }

    }


    comment +=
      '\n[Требуется подтверждение расчета менеджером]';


    document.getElementById(
      'wood-comment'
    ).value =
      comment;

  }


  /*
   * ==========================================================
   * SEND
   * ==========================================================
   */

  var finalButton =
    document.getElementById(
      'wood-submit-final-btn'
    );


  if (finalButton) {

    finalButton.addEventListener(
      'click',
      function () {
        openManagerForm('wood');
      }
    );

  }


  var sendButton =
    document.getElementById(
      'wood-send-btn'
    );


  if (sendButton) {

    sendButton.addEventListener(
      'click',
      function () {

        var name =
          document.getElementById(
            'wood-name'
          ).value.trim();

        var phone =
          document.getElementById(
            'wood-phone'
          ).value.trim();

        var email =
          document.getElementById(
            'wood-email'
          ).value.trim();

        var org =
          document.getElementById(
            'wood-org'
          ).value.trim();

        var comment =
          document.getElementById(
            'wood-comment'
          ).value.trim();


        if (!name || !phone || !email) {

          alert(
            'Пожалуйста, заполните обязательные поля: Имя, Телефон и Email'
          );

          return;

        }


        var body =
          'Здравствуйте!\n\n';

        body +=
          'Имя: ' +
          name +
          '\n';

        body +=
          'Телефон: ' +
          phone +
          '\n';

        body +=
          'Email: ' +
          email +
          '\n';


        if (org) {

          body +=
            'Компания: ' +
            org +
            '\n';

        }


        body +=
          '\n' +
          comment +
          '\n\n' +
          'Прошу связаться для подтверждения.';


        window.location.href =
          'mailto:veles.mf@yandex.ru' +
          '?subject=' +
          encodeURIComponent(
            'Запрос расчета деревянных опор с сайта'
          ) +
          '&body=' +
          encodeURIComponent(
            body
          );

      }
    );

  }

})();
</script>

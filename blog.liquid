{% assign blog_size = settings.blog_size | default: "6" %}
{% paginate articles by blog_size %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Montserrat:wght@400;500;600;700&display=swap');

  .vl-blog-page,
  .vl-blog-page * { box-sizing: border-box; }

  .vl-blog-page {
    width: min(100% - 40px, 1200px);
    margin: 0 auto;
    padding: 64px 0;
    background: #fff;
    color: #000;
    font-family: 'Montserrat', sans-serif;
  }

  .vl-blog-title {
    margin: 0 0 40px;
    font-family: 'Playfair Display', serif;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  .vl-blog-title::after {
    content: '';
    display: block;
    width: 80px;
    height: 2px;
    margin: 16px auto 0;
    background: #000;
  }

  .vl-blog-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .vl-blog-article {
    display: block;
    padding: 24px;
    border: 1px solid #000;
    border-radius: 12px;
    background: #fff;
    color: #000;
    text-decoration: none;
    transition: transform .2s ease, opacity .2s ease;
  }

  .vl-blog-article:hover { transform: translateY(-2px); opacity: .8; }

  .vl-blog-article__title {
    margin: 0 0 12px;
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
  }

  .vl-blog-article__excerpt {
    margin: 0 0 16px;
    color: #444;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.8;
  }

  .vl-blog-article__meta {
    padding-top: 12px;
    border-top: 1px solid #000;
    color: #777;
    font-size: 13px;
  }

  .vl-blog-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-top: 40px;
  }

  .vl-blog-pagination a,
  .vl-blog-pagination span {
    color: #000;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }

  .vl-blog-pagination a:hover { opacity: .6; }

  @media (max-width: 768px) {
    .vl-blog-page {
      width: min(100% - 30px, 1200px);
      padding: 48px 0;
    }

    .vl-blog-title { font-size: 28px; margin-bottom: 32px; }
    .vl-blog-grid { grid-template-columns: 1fr; }
    .vl-blog-article { padding: 20px; }
    .vl-blog-article__title { font-size: 20px; }
  }
</style>

<section class="vl-blog-page">
  <h1 class="vl-blog-title">{{ blog.title }}</h1>

  <div class="vl-blog-grid">
    {% for article in articles %}
      <a href="{{ article.url }}" class="vl-blog-article">
        <div class="vl-blog-article__title">{{ article.title }}</div>
        <div class="vl-blog-article__excerpt">
          {{ article.excerpt_or_content | strip_html | truncate: 160 }}
        </div>
        <div class="vl-blog-article__meta">
          {{ article.published_at | date: "%d.%m.%Y" }}
        </div>
      </a>
    {% else %}
      <p style="grid-column:1/-1; text-align:center; color:#555; padding:40px 0;">В блоге пока нет статей.</p>
    {% endfor %}
  </div>

  {% if paginate.pages > 1 %}
    <div class="vl-blog-pagination">
      {{ paginate | default_pagination }}
    </div>
  {% endif %}
</section>

{% endpaginate %}
